								texture = "[Country.AccessActiveLawFromGroup('lawgroup_church_and_state').GetTexture]"
							}
							
							background = {
								texture = "gfx/interface/backgrounds/subject_liberty_desire_frame.dds"
							}
							
							fancy_flag_ui = {
								size = { 80 60 }
								position = { 10 5 }
								parentanchor = top|left
								
								blockoverride "overlay_button_and_bg_glow_position" {
									position = { -9 -4 }
								}
								
								blockoverride "rank_badge_block" {}
							}
							
							rank_badge = {
								size = { 45 45 }
								position = { -15 -15 }
								parentanchor = top|left
								
								blockoverride "datacontext " {}
								
								blockoverride "font_size_under_100_rank" {
									using = fontsize_medium
								}
							}
							
							icon = {
								size = { 200 20 }
								position = { 5 -2}
								parentanchor = bottom|left
								background = {
									using = dark_area
									alpha = 0.3
								}
								
								textbox = {
									autoresize = yes
									align = nobaseline
									elide = right
									fontsize_min = 12
									using = fontsize_medium
									raw_text = "#bold [Country.GetNameNoFlag]#!"
								}
							}
							
							kog_holy_sites_widget = {
								parentanchor = center
								position = { -10 -8 }
							}
							
							kog_global_patriarch_widget = {
								parentanchor = right|vcenter
							}
							
						}
					}
				}
			}
		}
	}
	
	type kog_global_cardinal_widget = widget {
		size = { 140 100 }
		
		block "datacontext" {
			datacontext = "[Country.GetInterestGroupOfType('ig_devout').GetLeader]"
		}
		
		character_portrait_medium = {
			parentanchor = center
			position = { 0 -10 }
			blockoverride "show_hat" {}
			blockoverride "tooltip" {} #TODO Remove when Tooltip doesnt cause error anymore
			blockoverride "portrait_icons" {} #TODO Remove when Tooltip doesnt cause error anymore
			blockoverride "portrait_button" {} #TODO Remove when Tooltip doesnt cause error anymore
		}
		
		default_header_clean_faded = {
			size = { 110 25 }
			parentanchor = bottom|hcenter
			blockoverride "text" {}
		}
		
		textbox = {
			text = "kog_cardinal_name"
			parentanchor = bottom|hcenter
			position = { 0 -2 }
			autoresize = yes
			max_width = 250
			elide = right
			using = fontsize_medium
		}
		
		textbox = {
			text = "kog_cardinal_gravitas"
			parentanchor = right|vcenter
			position = { -5 18 }
			autoresize = yes
			elide = right
			using = fontsize_medium
			
			background = {
				using = dark_area
				alpha = 0.5
			}
			
			tooltip = "kog_cardinal_gravitas_breakdown"
		}
		
	}
	
