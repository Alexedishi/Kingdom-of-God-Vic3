	####---------- Holy Sites Panel ----------####
	type kog_holy_sites_panel = vbox {
		layoutpolicy_horizontal = expanding
		maximumsize = { -1 400 }
		minimumsize = { -1 400 }
		margin = { 10 0 }
		spacing = 10
		
		visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'sites')]"
		
		background = {
			using = entry_bg
			margin = { -10 0 }
		}
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "kog_gui_holy_sites_header"
			}
		}
		
		textbox = {
			text = "kog_gui_holy_site_count"
			autoresize = yes
			elide = right
			using = fontsize_large
		}
		
		# Catholic Holy Sites
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			spacing = 5
			
			# Rome
			widget = {
				size = { 100 100 }
				
				icon = {
					visible = "[GetPlayer.MakeScope.Var('kog_controls_rome').IsSet]"
					using = selected_sidepanel_animation
					size = { 90% 90% }
					alwaystransparent = yes
					parentanchor = center
					using = default_fade_in_out
				}
				icon = {
					size = { 100 100 }
					texture = "gfx/interface/icons/generic_icons/kog_holy_site_rome.dds"
					
					modify_texture = {
						visible = "[Not(GetPlayer.MakeScope.Var('kog_controls_rome').IsSet)]"
						texture = "gfx/interface/backgrounds/grey.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = normal
						alpha = 0.5
					}
				}
				tooltip = "kog_gui_rome_control_status"
			}
			
			vertical_divider_full = {}
			
