	type canon_law_entry = widget {
		size = { 250 120 }
		using = entry_bg_fancy
		
		background = {
			block "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/canon_law_image_mask.dds"
			}
			size = { 100% 100% }
			spriteType = Corneredstretched
			spriteborder = { 0 20 }
			margin = { -5 -3 }
			
			modify_texture = {
				texture = "gfx/interface/illustrations/canon_laws/canon_law_image_mask.dds"
				spriteType = Corneredstretched
				blend_mode = alphamultiply
				texture_density = 2
			}
		}
		
		default_header_clean_faded = {
			parentanchor = top|hcenter
			position = { 0 0 }
			size = { 200 35 }
			blockoverride "text" {
			}
			textbox = {
				block "canon_law_group" {
					raw_text = "#TODO Override canon_law_group!"
				}
				parentanchor = center
				position = { 0 0 }
				autoresize = yes
				max_width = 200
				elide = right
				using = fontsize_medium
			}
		}
		textbox = {
			text = "kog_gui_law_type_header"
			parentanchor = top|left
			position = { 10 35 }
			autoresize = yes
			max_width = 200
			elide = right
			using = fontsize_medium
			
			background = {
				using = dark_area
				margin = { 2 2 }
			}
		}
		textbox = {
			block "canon_law_flag" {
				raw_text = "#TODO Override canon_law_flag!"
			}
			parentanchor = top|left
			position = { 10 55 }
			autoresize = yes
			max_width = 200
			elide = right
			using = fontsize_medium
		}
		hbox = {
			parentanchor = bottom|hcenter
			position = { 0 -8 }
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = shrinking
			spacing = 10
			minimumsize = { -1 35 }
			maximumsize = { -1 35 }
			
			background = {
				using = dark_area
				margin = { -10 2 }
			}
			
			expand = {}
			block "canon_law_button_content" {}
			expand = {}
		}
	}
	
	type kog_canon_law_button = button_icon_round {
		size = { 35 35 }
		block "button_datacontext" {}
		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		clicksound = "event:/kog_focus_selected"
	}
	
	####---------- Curia Panel ----------####
	type kog_curia_panel = vbox {
		visible = "no"
	}
	
	####---------- Holy Sites Panel ----------####
	type kog_holy_sites_panel = vbox {
		visible = "no"
	}
	
	####---------- Membership Panel ----------####
	type kog_membership_panel = vbox {
		visible = "no"
	}
