	####---------- Membership Panel ----------####
	type kog_catholic_global_panel = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 10 0 }
		using = default_fade_in_out
		
		visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'members')]"
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "kog_gui_members_header"
			}
		}
		
		scrollarea = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			
			max_update_rate = 60
			
			scrollbarpolicy_horizontal = always_off
			scrollbarpolicy_vertical = as_needed
			
			scrollbar_horizontal = {
				using = horizontal_scrollbar
			}
			
			scrollbar_vertical = {
				using = vertical_scrollbar
			}
			
			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 5
					margin = { 0 10 }
					
					datamodel = "[GetGlobalList('kog_catholic_ranking')]"
					
					item = {
						widget = {
							datacontext = "[Scope.GetCountry]"
							size = { 400 120 }
							
							icon = {
								using = dark_area
								using = frame_small_mask
								parentanchor = right
								size = { 400 100 }
								alpha = 0.2
								position = { 0 0 }
								
								modify_texture = {
									texture = "gfx/interface/masks/fade_horizontal_left.dds"
									spriteType = Corneredstretched
									spriteborder = { 0 0 }
									blend_mode = alphamultiply
								}
							}
							
							icon = {
								parentanchor = left|vcenter
								size = { 30 30 }
								position = { 15 19 }
								texture = "[Country.AccessActiveLawFromGroup('lawgroup_governance_principles').GetTexture]"
							}
							
							
							icon = {
								parentanchor = left|vcenter
								size = { 30 30 }
								position = { 50 15 }
								texture = "[Country.AccessActiveLawFromGroup('lawgroup_church_and_state').GetTexture]"
							}
							
							background = {
								texture = "gfx/interface/backgrounds/subject_liberty_desire_frame.dds"
							}
							
							fancy_flag_ui = {
								size = { 80 60 }
								position = { 10 5 }
								parentanchor = top|left
								
								blockoverride "overlay_button_and_bg_glow_position" {
									position = { -9 -4 }
								}
								
								blockoverride "rank_badge_block" {}
							}
							
							rank_badge = {
								size = { 45 45 }
								position = { -15 -15 }
								parentanchor = top|left
								
								blockoverride "datacontext " {}
								
								blockoverride "font_size_under_100_rank" {
									using = fontsize_medium
								}
							}
							
							icon = {
								size = { 200 20 }
								position = { 5 -2}
								parentanchor = bottom|left
								background = {
									using = dark_area
									alpha = 0.3
								}
								
								textbox = {
									autoresize = yes
									align = nobaseline
									elide = right
									fontsize_min = 12
									using = fontsize_medium
									raw_text = "#bold [Country.GetNameNoFlag]#!"
								}
							}
							
							kog_holy_sites_widget = {
								parentanchor = center
								position = { -10 -8 }
							}
							
							kog_global_cardinal_widget = {
								parentanchor = right|vcenter
							}
							
						}
					}
				}
			}
		}
		
		expand = {}
	}
	
