types kog_denominational_panels {
	type kog_head_of_faith_panel = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = shrinking
		spacing = 10
		block "seat_visibility" {}
		block "seat_datacontext" {}
		
		hbox = {
			default_header_clean_faded = {
				layoutpolicy_horizontal = expanding
				blockoverride "text" {}
				textbox = {
					text = "[Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_header'))]"
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 300
					elide = right
					using = fontsize_large
				}
				textbox = {
					text = "[Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_controller'))]"
					parentanchor = right|vcenter
					autoresize = yes
					max_width = 300
					elide = right
					using = fontsize_medium
				}
			}
		}
		
		## Character Portrait
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = shrinking
			
			character_portrait_medium_torso = {
				block "patriarch_datacontext" {}
				blockoverride "show_hat" {}
				blockoverride "tooltip" {} # Error Suppression
				blockoverride "portrait_icons" {} # Error Suppression
				blockoverride "portrait_button" {} # Error Suppression
				
				default_header_clean_faded = {
					size = { 150 35 }
					position = { 0 120 }
					parentanchor = center
					blockoverride "text" {
					}
					textbox = {
						text = "kog_gui_patriarch_name"
						parentanchor = center
						position = { 0 -2 }
						autoresize = yes
						max_width = 190
						elide = right
						using = fontsize_large
					}
				}
			}
			vbox = {
				background = {
					using = entry_bg_simple
				}
				margin = { 10 10 }
				textbox = {
					raw_text = "[concept_liturgical_rite]:"
					size = { 240 40 }
					elide = right
					using = fontsize_large
				}
				textbox = {
					text = "[Character.MakeScope.Var('kog_rite_var').GetFlagName]"
					size = { 240 40 }
					elide = right
					using = fontsize_medium
				}
				divider_clean = {}
				textbox = {
					raw_text = "[concept_liturgical_rite]:"
					size = { 240 40 }
					elide = right
					using = fontsize_large
				}
				textbox = {
					text = "[Character.MakeScope.Var('kog_liturgical_language').GetFlagName]"
					size = { 240 40 }
					elide = right
					using = fontsize_medium
				}
				divider_clean = {}
				textbox = {
					text = "kog_gui_opinion"
					size = { 240 40 }
					elide = right
					using = fontsize_large
				}
				textbox = {
					text = "kog_gui_opinion"
					size = { 240 40 }
					elide = right
					using = fontsize_medium
				}
			}
			vbox = {
				spacing = 5
				
				## Tetrarchy/Pentarchy/Mending Buttons
				button = {
					using = default_button_primary_big_action
					size = { 200 40 }
					text = "kog_gui_secure_tetrarchy"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_secure_tetrarchy_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_secure_tetrarchy_desc"
					
				}
				button = {
					using = default_button_primary_big_action
					size = { 200 40 }
					text = "kog_gui_secure_pentarchy"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_secure_pentarchy_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_secure_pentarchy_desc"
				}
				button = {
					using = default_button_primary_big_action
					size = { 200 40 }
					text = "kog_gui_mend_schism"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_mend_schism_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_mend_schism_desc"
				}
				green_progressbar_horizontal = {
					size = { 194 30 }
					visible = "[GetScriptedGui('kog_mending_progressbar_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					
					blockoverride "values" {
						min = 0
						max = 240
						value = "[Country.MakeScope.Var('kog_local').Var('kog_mending_var').GetValue]"
					}
					textbox = {
						parentanchor = center
						autoresize = yes
						visible = "[GetScriptedGui('kog_mending_progressbar_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						text = "kog_gui_mending_header"
						elide = right
						using = fontsize_medium
					}
				}
				
				# Autocephaly Button
				button = {
					parentanchor = center
					using = default_button_primary_big_action
					size = { 260 44 }
					text = "kog_gui_declare_autocephaly"
					using = fontsize_large
					
					datacontext = "[GetScriptedGui('kog_declare_autocephaly_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_declare_autocephaly_desc"
				}
				
				# Autocephaly Progressbar
				green_progressbar_horizontal = {
					parentanchor = center
					size = { 200 20 }
					visible = "[GetScriptedGui('kog_schism_progressbar_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					
					blockoverride "values" {
						min = 0
						max = 120
						value = "[Country.MakeScope.Var('kog_local').Var('kog_schism_var').GetValue]"
					}
					textbox = {
						parentanchor = center
						text = "kog_gui_autocephaly_header"
						autoresize = yes
						max_width = 300
						elide = right
						using = fontsize_medium
						visible = "[GetScriptedGui('kog_schism_progressbar_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}
				
				# Convoke Council Button
				button = {
					parentanchor = center
					using = default_button_primary_big_action
					size = { 260 44 }
					text = "kog_gui_convoke_council"
					using = fontsize_large
					
					datacontext = "[GetScriptedGui('kog_convoke_council_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_convoke_council_desc"
				}
			}
		}
		
		## Seat Interaction Buttons
		vbox = {
			spacing = 10
			
			## Top Row
			hbox = {
				spacing = 5
				
				# Seek Mandate Button
				button = {
					using = default_button_primary_big_action
					size = { 220 40 }
					text = "kog_seek_mandate"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_seek_mandate_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_seek_mandate_desc"
				}
				
				# Integrate Seat Button
				button = {
					using = default_button_primary_big_action
					size = { 180 40 }
					text = "kog_gui_integrate_seat"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_integrate_sgui')))]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_integrate_seat_desc"
				}
				
				# Integration Progressbar
				green_progressbar_horizontal = {
					size = { 180 20 }
					visible = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_integration_sgui'))).IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
					
					blockoverride "values" {
						min = 0
						max = 120
						value = "[GetPlayer.MakeScope.Var('kog_local').Var('kog_integration_var').GetValue]"
					}
					textbox = {
						parentanchor = center
						autoresize = yes
						
						text = "kog_gui_integration_progress"
						elide = right
						using = fontsize_medium
					}
				}
				
				# Enforce Rite Button
				button = {
					using = default_button_primary_big_action
					size = { 180 40 }
					text = "kog_gui_enforce_seat"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_enforce_sgui')))]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_enforce_seat_desc"
				}
				
				# Enforcement Progressbar
				green_progressbar_horizontal = {
					size = { 180 20 }
					visible = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_enforcement_sgui'))).IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
					
					blockoverride "values" {
						min = 0
						max = 120
						value = "[GetPlayer.MakeScope.Var('kog_local').Var('kog_enforcement_var').GetValue]"
					}
					textbox = {
						parentanchor = center
						autoresize = yes
						
						text = "kog_gui_enforcement_progress"
						elide = right
						using = fontsize_medium
					}
				}
				
				# Assert Supremacy Button
				button = {
					using = default_button_primary_big_action
					size = { 220 40 }
					text = "kog_assert_seat"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_assert_sgui')))]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_assert_rome_button"
				}
			}
			
			hbox = {
				spacing = 10
				margin_bottom = 10
				
				# Improve Relations Button
				button = {
					using = default_button_action
					size = { 200 40 }
					text = "kog_gui_improve_relations"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_start_sway_sgui')))]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_improve_relations_desc"
				}
				
				# Cease Diplomacy Button
				button = {
					using = default_button_action
					size = { 200 40 }
					text = "kog_gui_cease_diplomacy"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_stop_sway_sgui')))]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_cease_diplomacy_desc"
				}
				
				# Damage Relations Button
				button = {
					using = default_button_action
					size = { 200 40 }
					text = "kog_gui_damage_relations"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_start_harm_sgui')))]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_damage_relations_desc"
				}
				
				# Cease Hostilities Button
				button = {
					using = default_button_action
					size = { 200 40 }
					text = "kog_gui_cease_hostilities"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_stop_harm_sgui')))]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_cease_hostilities_desc"
				}
			}
		}
	}
	
	type kog_canon_laws_panel = vbox {
		visible = "no"
	}
	
	type kog_curia_panel = vbox {
		visible = "no"
	}
	
	type kog_holy_sites_panel = vbox {
		visible = "no"
	}
	
	type kog_membership_panel = vbox {
		visible = "no"
	}
	
	type kog_denominational_tabs = tab_buttons {
		margin = { 15 0 }
		layoutpolicy_horizontal = expanding
		margin_bottom = -5
		blockoverride "first_button" {
			text = "kog_gui_head_of_faith_header"
		}
		blockoverride "first_button_click" {
			onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'head')]"
		}
		blockoverride "first_button_visibility" {
			visible = "[Or(GetVariableSystem.HasValue('kog_denominational_tab', 'head'), Not(GetVariableSystem.Exists('kog_denominational_tab')))]"
		}
		blockoverride "first_button_visibility_checked" {
			visible = "[And(Not(GetVariableSystem.HasValue('kog_denominational_tab', 'head')), GetVariableSystem.Exists('kog_denominational_tab'))]"
		}
		blockoverride "first_button_selected" {
			text = "kog_gui_head_of_faith_header"
		}
		
		blockoverride "second_button" {
			text = "kog_gui_canon_law_header"
		}
		blockoverride "second_button_click" {
			onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'laws')]"
		}
		blockoverride "second_button_visibility" {
			visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'laws')]"
		}
		blockoverride "second_button_visibility_checked" {
			visible = "[Not(GetVariableSystem.HasValue('kog_denominational_tab', 'laws'))]"
		}
		blockoverride "second_button_selected" {
			text = "kog_gui_canon_law_header"
		}
		
		blockoverride "third_button" {
			text = "kog_gui_collegium_header"
		}
		blockoverride "third_button_click" {
			onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'curia')]"
		}
		blockoverride "third_button_visibility" {
			visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'curia')]"
		}
		blockoverride "third_button_visibility_checked" {
			visible = "[And(Not(GetVariableSystem.HasValue('kog_denominational_tab', 'curia')), GetScriptedGui('kog_catholic_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		}
		blockoverride "third_button_selected" {
			text = "kog_gui_collegium_header"
		}
		
		blockoverride "fourth_button" {
			text = "kog_gui_holy_sites_header"
		}
		blockoverride "fourth_button_click" {
			onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'sites')]"
		}
		blockoverride "fourth_button_visibility" {
			visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'sites')]"
		}
		blockoverride "fourth_button_visibility_checked" {
			visible = "[Not(GetVariableSystem.HasValue('kog_denominational_tab', 'sites'))]"
		}
		blockoverride "fourth_button_selected" {
			text = "kog_gui_holy_sites_header"
		}
		
		blockoverride "fifth_button" {
			text = "kog_gui_members_header"
		}
		blockoverride "fifth_button_click" {
			onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'members')]"
		}
		blockoverride "fifth_button_visibility" {
			visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'members')]"
		}
		blockoverride "fifth_button_visibility_checked" {
			visible = "[Not(GetVariableSystem.HasValue('kog_denominational_tab', 'members'))]"
		}
		blockoverride "fifth_button_selected" {
			text = "kog_gui_members_header"
		}
	}
	
	
}