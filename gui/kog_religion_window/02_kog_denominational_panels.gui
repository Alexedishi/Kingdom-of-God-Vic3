	type kog_canon_law_entry = widget {
		size = { 250 120 }
		using = entry_bg_fancy
		
		background = {
			block "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/canon_law_image_mask.dds"
			}
			size = { 100% 100% }
			spriteType = Corneredstretched
			spriteborder = { 0 20 }
			margin = { -5 -3 }
			
			modify_texture = {
				texture = "gfx/interface/illustrations/canon_laws/canon_law_image_mask.dds"
				spriteType = Corneredstretched
				blend_mode = alphamultiply
				texture_density = 2
			}
		}
		
		default_header_clean_faded = {
			parentanchor = top|hcenter
			position = { 0 0 }
			size = { 200 35 }
			blockoverride "text" {
			}
			textbox = {
				block "canon_law_group" {
					raw_text = "#TODO Override canon_law_group!"
					using = look_at_me_text_animation
				}
				parentanchor = center
				position = { 0 0 }
				autoresize = yes
				max_width = 200
				elide = right
				using = fontsize_medium
			}
		}
		textbox = {
			text = "kog_gui_law_type_header"
			parentanchor = top|left
			position = { 10 35 }
			autoresize = yes
			max_width = 200
			elide = right
			using = fontsize_medium
			
			background = {
				using = dark_area
				margin = { 2 2 }
			}
		}
		textbox = {
			block "canon_law_flag" {
				raw_text = "#TODO Override canon_law_flag!"
				using = look_at_me_text_animation
			}
			parentanchor = top|left
			position = { 10 55 }
			autoresize = yes
			max_width = 200
			elide = right
			using = fontsize_medium
		}
		hbox = {
			parentanchor = bottom|hcenter
			position = { 0 -8 }
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = shrinking
			spacing = 10
			minimumsize = { -1 35 }
			maximumsize = { -1 35 }
			
			background = {
				using = dark_area
				margin = { -10 2 }
			}
			
			expand = {}
			block "canon_law_button_content" {}
			expand = {}
		}
	}
	
	type kog_canon_law_button = button_icon_round {
		size = { 35 35 }
		block "button_datacontext" {}
		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		clicksound = "event:/kog_focus_selected"
	}
	
	####---------- Curia Panel ----------####
	type kog_curia_panel = vbox {
		layoutpolicy_vertical = shrinking
		layoutpolicy_horizontal = expanding
		maximumsize = { -1 400 }
		minimumsize = { -1 400 }
		using = default_fade_in_out
		margin_bottom = 5
		
		visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'curia')]"
		
		background = {
			using = entry_bg_unit_dark
			margin = { -10 -5 }
		}
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "kog_gui_college_header"
			}
		}
		
		# Preferatus
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 5
			margin = { 0 10 }
			
			datamodel = "[GetGlobalList('kog_cardinals_list')]"
			
			item = {
				kog_collegium_preferatus_widget = {}
			}
		}
		
		# First Row of Candidates
		hbox = {
			layoutpolicy_horizontal = shrinking
			layoutpolicy_vertical = expanding
			spacing = 30
			margin = { 0 10 }
			
			datamodel = "[GetGlobalList('kog_cardinals_list')]"
			
			item = {
				kog_collegium_cardinal_widget = {
					blockoverride "row_visibility" {
						visible = "[Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)2'), Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)3'), EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)4'))))]"
					}
				}
			}
		}
		
		# Second Row of Candidates
		hbox = {
			layoutpolicy_horizontal = shrinking
			layoutpolicy_vertical = expanding
			spacing = 30
			margin = { 0 10 }
			
			datamodel = "[GetGlobalList('kog_cardinals_list')]"
			
			item = {
				kog_collegium_cardinal_widget = {
					blockoverride "row_visibility" {
						visible = "[Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)5'), Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)6'), EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)7')))]"
					}
				}
			}
		}
		
		expand = {}
	}
	
	type kog_collegium_preferatus_widget = widget {
		size = { 200 150 }
		datacontext = "[Scope.GetCharacter]"
		visible = "[EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0')]"
		
		character_portrait_medium_torso = {
			parentanchor = center
			blockoverride "show_hat" {}
			blockoverride "tooltip" {} #TODO Remove when Tooltip doesnt cause error anymore
			blockoverride "portrait_icons" {} #TODO Remove when Tooltip doesnt cause error anymore
			blockoverride "portrait_button" {} #TODO Remove when Tooltip doesnt cause error anymore
		}
		
		default_header_clean_faded = {
			size = { 210 36 }
			parentanchor = bottom|hcenter
			blockoverride "text" {}
			textbox = {
				text = "kog_cardinal_name"
				parentanchor = bottom|hcenter
				position = { 0 -5 }
				autoresize = yes
				max_width = 250
				elide = right
				using = fontsize_large
			}
		}
		
		textbox = {
			text = "kog_cardinal_gravitas"
			parentanchor = right|vcenter
			position = { 10 27 }
			autoresize = yes
			elide = right
			using = fontsize_large
			
			background = {
				using = dark_area
				alpha = 0.5
				margin = { 2 2 }
			}
			
			tooltip = "kog_cardinal_gravitas_breakdown"
		}
		
		icon = {
			size = { 48 32 }
			parentanchor = left|vcenter
			position = { -5 24 }
			
			texture = "[Country.GetFlag.GetSmallFlagTexture]"
			alwaystransparent = yes
			
			frame = "[Country.GetFlag.GetSmallFlagFrame]"
			framesize = "[GetSmallFlagFrameSize]"
			
			using = flag_overlay
			
			icon = {
				texture = "gfx/interface/flag/flag_power_small.dds"
				size = { 62 46 }
				framesize = { 124 92 }
				frame = "[Country.GetRankIconIndex]"
				alwaystransparent = yes
				parentanchor = center
			}
		}
		
		widget = {
			parentanchor = top|right
			position = { -30 15 }
			size = { 35 35 }
			
			icon = {
				texture = "gfx/interface/backgrounds/round_frame_dec.dds"
				parentanchor = center
				size = { 100% 100% }
				
				icon = {
					using = rotate_glow_animation_02
					size = { 200% 200% }
					parentanchor = center
				}
				
				icon = {
					texture = "gfx/interface/icons/generic_icons/kog_preferatus.dds"
					parentanchor = center
					size = { 100% 100% }
					position = { 4 4 }
				}
			}
			tooltip = "kog_placeholder_text"
		}
	}
	
