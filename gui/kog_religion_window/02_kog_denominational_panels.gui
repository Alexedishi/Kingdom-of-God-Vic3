			# Catholic Holy Sites
			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = preferred
				spacing = 5
				
				# Rome
				widget = {
					size = { 20 20 }
					
					icon = {
						visible = "[Country.MakeScope.Var('kog_controls_rome').IsSet]"
						using = selected_sidepanel_animation
						size = { 90% 90% }
						alwaystransparent = yes
						parentanchor = center
						using = default_fade_in_out
					}
					icon = {
						size = { 20 20 }
						texture = "gfx/interface/icons/generic_icons/kog_holy_site_rome.dds"
						
						modify_texture = {
							visible = "[Not(Country.MakeScope.Var('kog_controls_rome').IsSet)]"
							texture = "gfx/interface/backgrounds/grey.dds"
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = normal
							alpha = 0.5
