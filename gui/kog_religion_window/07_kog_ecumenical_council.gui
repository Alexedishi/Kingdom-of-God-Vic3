types eocfm_ecumenical_council_panels {
	
	type eocfm_catholic_council_panel = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		minimumsize = { -1 200 }
		maximumsize = { -1 300 }
		using = default_fade_in_out

		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "eocfm_gui_ecumenical_council_header"
			}
		}
		
		eocfm_inactive_council_panel = {
			blockoverride "inactive_visibility" {
				visible = "[Not(GetScriptedGui('eocfm_catholic_council_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			}
		}
		
		eocfm_active_council_panel = {
			blockoverride "active_visibility" {
				visible = "[GetScriptedGui('eocfm_catholic_council_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			blockoverride "council_location" {
				text = "eocfm_gui_catholic_council_location"
			}
			blockoverride "council_host" {
				text = "eocfm_gui_catholic_council_host"
			}
			blockoverride "council_matter" {
				text = "eocfm_gui_catholic_council_matter"
			}
			blockoverride "council_votes" {
				text = "eocfm_gui_catholic_council_votes"
			}
			blockoverride "council_supporters" {
				text = "eocfm_gui_catholic_council_supporters"
			}
			blockoverride "council_detractors" {
				text = "eocfm_gui_catholic_council_detractors"
			}
			blockoverride "council_outcome" {
				text = "eocfm_gui_catholic_council_outcome"
			}
		}
	}
	
