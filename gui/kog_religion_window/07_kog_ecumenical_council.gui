	type eocfm_inactive_council_panel = hbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		
		block "inactive_visibility" {}
		
		textbox = {
			autoresize = yes
			text = "eocfm_gui_ecumenical_council_none"
			elide = right
			using = fontsize_xl
		}
	}
	
	type eocfm_active_council_panel = vbox {
		layoutpolicy_horizontal = preferred
		layoutpolicy_vertical = preferred
		margin_top = 10
		
		block "active_visibility" {}
		
		background = {
			using = entry_bg_simple
		}
		
		background = {
			using = dark_area
			margin = { -50 -2 }
			
			modify_texture = {
				texture = "gfx/interface/masks/fade_horizontal_center.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = alphamultiply
			}
		}
		
		textbox = {
			autoresize = yes
			block "council_location" {
				raw_text = "Council Location Placeholder"
			}
			elide = right
			using = fontsize_mega
		}
		textbox = {
			autoresize = yes
			block "council_host" {
				raw_text = "Council Host Placeholder"
			}
			elide = right
			using = fontsize_large
		}
		textbox = {
			autoresize = yes
			block "council_matter" {
				raw_text = "Council Matter Placeholder"
			}
			elide = right
			using = fontsize_xl
		}
		textbox = {
			autoresize = yes
			block "council_votes" {
				raw_text = "Council Votes Placeholder"
			}
			elide = right
			using = fontsize_large
		}
		
		hbox = {
			layoutpolicy_horizontal = shrinking
			layoutpolicy_vertical = preferred
			
			spacing = 20
			
			widget = {
				size = { 200 150 }
				background = {
					using = entry_bg
				}
				textbox = {
					parentanchor = top|left
					position = { 10 5 }
					autoresize = yes
					block "council_supporters" {
						raw_text = "Council Supporters Placeholder"
					}
					elide = right
					using = fontsize_large
				}
				
				textbox = {
					parentanchor = top|left
					position = { 10 30 }
					autoresize = yes
					block "council_detractors" {
						raw_text = "Council Detractors Placeholder"
					}
					elide = right
					using = fontsize_large
				}
				
				textbox = {
					parentanchor = center
					position = { 0 0 }
					autoresize = yes
					text = "eocfm_gui_council_stance"
					elide = right
					using = fontsize_large
				}
				
				button_icon_round_big_action = {
					parentanchor = center
					datacontext = "[GetScriptedGui('eocfm_oppose_council_sgui')]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					position = { -50 45 }
					size = { 40 40 }

					icon = {
						texture = "gfx/interface/icons/diplo_play_icons/stance_supports.dds"
						mirror = vertical
						tooltip = "eocfm_gui_ecumenical_council_oppose"
						parentanchor = center
						size = { 75% 75% }
					}
				}
				button_icon_round_big_action = {
					parentanchor = center
					datacontext = "[GetScriptedGui('eocfm_abstain_council_sgui')]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					position = { 0 45 }
					size = { 40 40 }

					icon = {
						texture = "gfx/interface/icons/diplo_play_icons/stance_on_the_fence.dds"
						tooltip = "eocfm_gui_ecumenical_council_abstain"
						parentanchor = center
						size = { 75% 75% }
					}
				}
				button_icon_round_big_action = {
					parentanchor = center
					datacontext = "[GetScriptedGui('eocfm_support_council_sgui')]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					position = { 50 45 }
					size = { 40 40 }

					icon = {
						texture = "gfx/interface/icons/diplo_play_icons/stance_supports.dds"
						tooltip = "eocfm_gui_ecumenical_council_support"
						parentanchor = center
						size = { 75% 75% }
					}
				}
			}
			
			widget = {
				size = { 200 150 }
				icon = {
					parentanchor = center
					texture = "gfx/interface/backgrounds/round_frame_dec.dds"
					size = { 150 150 }
				}
				icon = {
					parentanchor = center
					texture = "gfx/interface/icons/invention_icons/nationalism.dds"
					size = { 100 100 }
				}
				
			}
		}
		
		textbox = {
			autoresize = yes
			block "council_outcome" {
				raw_text = "Council Outcome Placeholder"
			}
			elide = right
			using = fontsize_xl
		}
		
		expand = {}
		
	}
	
}