types kog_encyclical_panels {
	
	# Dummy Panel
	type kog_encyclical_dummy_panel = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		using = default_fade_in_out
		minimumsize = { -1 200 }
		maximumsize = { -1 300 }
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "kog_gui_encyclical_header"
			}
		}
		
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			
			textbox = {
				autoresize = yes
				text = "kog_gui_encyclicals_disabled"
				elide = right
				using = fontsize_xl
			}
		}
	}
	
	type = kog_catholic_encyclical_panel = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		using = default_fade_in_out
		minimumsize = { -1 200 }
		maximumsize = { -1 300 }
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "kog_gui_encyclical_header"
			}
		}
		
		# Inactive Panel
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			margin_left = 15
			
			visible = "[Not(GetScriptedGui('kog_catholic_encyclicals_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			
			textbox = {
				autoresize = yes
				text = "kog_gui_no_encyclical"
				elide = right
				using = fontsize_xl
			}
		}
		
		# Active Panel
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			margin_left = 15
			
			visible = "[Not(GetScriptedGui('kog_catholic_encyclicals_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = preferred
				spacing = 15
				margin_top = 10
				
				# Mirari Vos
				kog_encyclical_widget = {
					blockoverride "datacontext" {
						datacontext = "[GetScriptedGui('kog_orthodox_mirari_vos_sgui')]"
					}
					blockoverride "encyclical_icon" {
						texture = "gfx/interface/icons/invention_icons/egalitarianism.dds"
					}
					blockoverride "encyclical_name" {
						text = "kog_gui_encyclical_catholic_mirari_vos"
					}
				}
				expand = {}
			}
		}
		
		
	}
	
	type = kog_orthodox_encyclical_panel = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		using = default_fade_in_out
		minimumsize = { -1 200 }
		maximumsize = { -1 300 }
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "kog_gui_encyclical_header"
			}
		}
		
		# Inactive Panel
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			margin_left = 15
			
			visible = "[Not(GetScriptedGui('kog_orthodox_encyclicals_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			
			textbox = {
				autoresize = yes
				text = "kog_gui_no_encyclical"
				elide = right
				using = fontsize_xl
			}
		}
		
		# Active Panel
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			margin_left = 15
			
			visible = "[GetScriptedGui('kog_orthodox_encyclicals_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = preferred
				spacing = 15
				margin_top = 10
				
				# Encyclical of the Eastern Patriarchs
				kog_encyclical_widget = {
					blockoverride "datacontext" {
						datacontext = "[GetScriptedGui('kog_orthodox_easterners_sgui')]"
					}
					blockoverride "encyclical_icon" {
						texture = "gfx/interface/icons/invention_icons/nationalism.dds"
					}
					blockoverride "encyclical_name" {
						text = "kog_gui_encyclical_orthodox_easterners"
					}
				}
				# Encyclical of the Fraternity of Churches
				kog_encyclical_widget = {
					blockoverride "datacontext" {
						datacontext = "[GetScriptedGui('kog_orthodox_fraternity_sgui')]"
					}
					blockoverride "encyclical_icon" {
						texture = "gfx/interface/icons/invention_icons/nationalism.dds"
					}
					blockoverride "encyclical_name" {
						text = "kog_gui_encyclical_orthodox_fraternity"
					}
				}
				expand = {}
			}	
		}
	}
	
	type kog_encyclical_widget = widget {
		size = { 350 60 }
		block "datacontext" {}
		visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		
		background = {
			using = entry_bg
			margin = { 5 5 }
		}
		icon = {
			parentanchor = left|top
			texture = "gfx/interface/backgrounds/round_frame_dec.dds"
			size = { 60 60 }
			
			icon = {
				parentanchor = center
				block "encyclical_icon" {
					texture = "gfx/interface/icons/invention_icons/nationalism.dds"
				}
				size = { 45 45 }
			}
		}
		textbox = {
			parentanchor = left|top
			margin_left = 65
			margin_top = 10
			autoresize = yes
			block "encyclical_name" {
				raw_text = "dummy"
			}
			elide = right
			using = fontsize_medium
		}
		textbox = {
			visible = "[Not(ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ))]"
			parentanchor = left|top
			margin_left = 65
			margin_top = 30
			autoresize = yes
			text = "ecofm_gui_encyclical_bad"
			elide = right
			using = fontsize_medium
			using = look_at_me_animation
		}
		textbox = {
			visible = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			parentanchor = left|top
			margin_left = 65
			margin_top = 30
			autoresize = yes
			text = "ecofm_gui_encyclical_good"
			elide = right
			using = fontsize_medium
		}
	}
	
}