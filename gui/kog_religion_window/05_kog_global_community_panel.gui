							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = normal
							alpha = 0.5
						}
					}
					tooltip = "kog_gui_antioch_control_status"
				}
				
				# Jerusalem
				widget = {
					size = { 20 20 }
					
					icon = {
						visible = "[Country.MakeScope.Var('kog_controls_jerusalem').IsSet]"
						using = selected_sidepanel_animation
						size = { 90% 90% }
						alwaystransparent = yes
						parentanchor = center
						using = default_fade_in_out
					}
					icon = {
						size = { 20 20 }
						texture = "gfx/interface/icons/gui_icons/holy_site_jerusalem.dds"
						
