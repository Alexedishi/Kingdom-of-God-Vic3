			blockoverride "tooltip" {} #TODO Remove when Tooltip doesnt cause error anymore
			blockoverride "portrait_icons" {} #TODO Remove when Tooltip doesnt cause error anymore
			blockoverride "portrait_button" {} #TODO Remove when Tooltip doesnt cause error anymore
		}
		
		default_header_clean_faded = {
			size = { 110 25 }
			parentanchor = bottom|hcenter
			blockoverride "text" {}
		}
		
		textbox = {
			text = "kog_cardinal_name"
			parentanchor = bottom|hcenter
			position = { 0 -2 }
			autoresize = yes
			max_width = 250
			elide = right
			using = fontsize_medium
		}
		
	}
	
	type kog_holy_sites_widget = widget {
		size = { 180 75 }
		
		background = {
			using = entry_bg_simple
		}
		
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			
			# Catholic Holy Sites
			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = preferred
				spacing = 5
				
				# Rome
				widget = {
					size = { 20 20 }
					
					icon = {
						visible = "[Country.MakeScope.Var('kog_controls_rome').IsSet]"
						using = selected_sidepanel_animation
						size = { 90% 90% }
						alwaystransparent = yes
						parentanchor = center
						using = default_fade_in_out
					}
					icon = {
						size = { 20 20 }
						texture = "gfx/interface/icons/gui_icons/holy_site_rome.dds"
						
						modify_texture = {
							visible = "[Not(Country.MakeScope.Var('kog_controls_rome').IsSet)]"
							texture = "gfx/interface/backgrounds/grey.dds"
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = normal
							alpha = 0.5
						}
					}
					tooltip = "kog_gui_rome_control_status"
				}
				
				vertical_divider_full = {}
				
				# Santiago
				widget = {
					size = { 20 20 }
					
					icon = {
						visible = "[Country.MakeScope.Var('kog_controls_santiago').IsSet]"
						using = selected_sidepanel_animation
						size = { 90% 90% }
						alwaystransparent = yes
						parentanchor = center
						using = default_fade_in_out
					}
					icon = {
						size = { 20 20 }
						texture = "gfx/interface/icons/gui_icons/holy_site_santiago.dds"
						
						modify_texture = {
							visible = "[Not(Country.MakeScope.Var('kog_controls_santiago').IsSet)]"
							texture = "gfx/interface/backgrounds/grey.dds"
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = normal
							alpha = 0.5
						}
					}
					tooltip = "kog_gui_santiago_control_status"
				}
				
				# Paris
				widget = {
					size = { 20 20 }
					
					icon = {
						visible = "[Country.MakeScope.Var('kog_controls_paris').IsSet]"
						using = selected_sidepanel_animation
						size = { 90% 90% }
						alwaystransparent = yes
						parentanchor = center
						using = default_fade_in_out
					}
					icon = {
						size = { 20 20 }
						texture = "gfx/interface/icons/gui_icons/holy_site_paris.dds"
						
						modify_texture = {
							visible = "[Not(Country.MakeScope.Var('kog_controls_paris').IsSet)]"
							texture = "gfx/interface/backgrounds/grey.dds"
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = normal
							alpha = 0.5
						}
					}
					tooltip = "kog_gui_paris_control_status"
				}
				
				# Cologne / Koln
				widget = {
					size = { 20 20 }
					
					icon = {
						visible = "[Country.MakeScope.Var('kog_controls_koln').IsSet]"
						using = selected_sidepanel_animation
						size = { 90% 90% }
						alwaystransparent = yes
						parentanchor = center
						using = default_fade_in_out
					}
					icon = {
						size = { 20 20 }
						texture = "gfx/interface/icons/gui_icons/holy_site_koln.dds"
						
						modify_texture = {
							visible = "[Not(Country.MakeScope.Var('kog_controls_koln').IsSet)]"
							texture = "gfx/interface/backgrounds/grey.dds"
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = normal
							alpha = 0.5
						}
					}
					tooltip = "kog_gui_koln_control_status"
				}
				
