							visible = "[Not(Country.MakeScope.Var('kog_controls_jerusalem').IsSet)]"
							texture = "gfx/interface/backgrounds/grey.dds"
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = normal
							alpha = 0.5
						}
					}
					tooltip = "kog_gui_jerusalem_control_status"
				}
				
				# Alexandria
				widget = {
					size = { 20 20 }
					
					icon = {
						visible = "[Country.MakeScope.Var('kog_controls_alexandria').IsSet]"
						using = selected_sidepanel_animation
						size = { 90% 90% }
						alwaystransparent = yes
						parentanchor = center
						using = default_fade_in_out
