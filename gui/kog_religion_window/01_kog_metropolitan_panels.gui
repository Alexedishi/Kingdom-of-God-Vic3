types kog_metropolitan_panel_types {
	type kog_metropolitan_bishop_panel = hbox {
		layoutpolicy_horizontal = expanding
		
		background = {
			texture = "gfx/interface/illustrations/event_backgrounds/kog_church.dds"
			margin_left = 18
			margin_right = 10
			margin_bottom = 10
			spriteType = Corneredtiled
			
			spriteborder_left = 200
			spriteborder_right = 60
			spriteborder_top = 170
			spriteborder_bottom = 180
			
			texture_density = 2
		}
		
		### RULER
		character_with_background = {
			datacontext = "[GetPlayer.MakeScope.Var('kog_local').Var('kog_metropolitan_var').GetCharacter]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			minimumsize = { -1 340 }
			
			blockoverride "character_layout" {
				position = { 0 0 }
				size = { 70% 100% }
			}
			blockoverride "character_portrait_size" {
				size = { 110% 110% }
			}
			
			# ruler stats
			flowcontainer = {
				parentanchor = right|bottom
				position = { -5 -15 }
				margin = { 0 10 }
				margin_right = 10
				direction = vertical
				spacing = 5
				
				background = {
					using = dark_area
					alpha = 0.85
					
					modify_texture = {
						texture = "gfx/interface/masks/fade_horizontal_left_full.dds"
						blend_mode = alphamultiply
					}
				}
				
				### Metropolitan Title
				metropolitan_stats_entry = {
					blockoverride "role_icon" {
						widget = {
							size = { 35 35 }
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/icons/character_role_icons/kog_patriarch.dds"
							}
						}
					}
					blockoverride "label" {
						raw_text = "[concept_metropolitan_bishop]"
					}
					blockoverride "text" {
						text = "kog_gui_metropolian_name"
					}
				}
				### State Religion
				metropolitan_stats_entry = {
					blockoverride "role_icon" {
						widget = {
							size = { 35 35 }
							icon = {
								size = { 100% 100% }
								texture = "[GetPlayer.GetStateReligion.GetTexture]"
							}
						}
					}
					
					blockoverride "label" {
						raw_text = "[concept_state_religion]"
					}
					blockoverride "text" {
						raw_text = "[GetPlayer.GetStateReligion.GetNameNoIcon]"
					}
				}
				
				### Liturgical Rite
				metropolitan_stats_entry = {
					blockoverride "icon_texture" {
						widget = {
							size = { 35 35 }
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/icons/generic_icons/kog_liturgical_rite.dds"
							}
						}
					}
					blockoverride "label" {
						raw_text = "[concept_liturgical_rite]"
					}
					blockoverride "text" {
						raw_text = "[GetPlayer.MakeScope.Var('kog_local').Var('kog_rite_var').GetFlagName]"
					}
				}
				### Religious Law
				metropolitan_stats_entry = {
					blockoverride "icon_texture" {
						widget = {
							size = { 35 35 }
							icon = {
								size = { 100% 100% }
								texture = "[AccessPlayer.AccessActiveLawFromGroup('lawgroup_church_and_state').GetTexture]"
							}
						}
					}
					blockoverride "label" {
						text = "kog_gui_religious_law_header"
					}
					blockoverride "text" {
						raw_text = "[AccessPlayer.AccessActiveLawFromGroup('lawgroup_church_and_state').GetName]"
					}
				}
			}
		}
	}
	
	type kog_catholic_metropolis_panel = vbox {
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		
		default_header_clean = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "kog_gui_metropolis_header"
			}
		}
		
		hbox = {
			layoutpolicy_vertical = shrinking
			layoutpolicy_horizontal = expanding
			spacing = 5
			
			vbox = {
				layoutpolicy_vertical = shrinking
				layoutpolicy_horizontal = expanding
				spacing = 10
				margin_top = 5
				margin_bottom = 15
				
				textbox = {
					autoresize = yes
					text = "kog_gui_national_piety"
					align = center|nobaseline
					elide = right
					using = fontsize_large
				}
				
				default_progressbar_horizontal = {
					size = { 250 24 }
					blockoverride "values" {
						min = 0
						max = 1000
						value = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('kog_capacity_value'))]"
					}
					textbox = {
						parentanchor = center
						autoresize = yes
						text = "kog_gui_national_piety_amount"
						align = center|nobaseline
						elide = right
						using = fontsize_medium
					}
					tooltip = "kog_gui_national_piety_breakdown"
				}
				
				button = { # Commission Icon Button
					size = { 240 44 }
					using = default_button_primary_big_action
					
					text = "kog_gui_venerate_apparition"
					using = fontsize_large
					
					datacontext = "[GetScriptedGui('kog_venerate_apparition_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_venerate_apparation_desc"
				}
			}
		}
		
		expand = {}
	}
	
	type kog_orthodox_metropolis_panel = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = shrinking
		using = default_fade_in_out
		maximumsize = { -1 400 }
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "kog_gui_ecclesiastic_header"
			}
		}
		
		hbox = {
			layoutpolicy_vertical = shrinking
			layoutpolicy_horizontal = expanding
			margin_top = 10
			spacing = 5
			using = default_fade_in_out
			
			expand = {}
			
			## Focus Actions ##
			vbox = {
				margin = { 20 20 }
				spacing = 20
				
				background = {
					using = entry_bg_unit_dark
				}
				
				### Metropolitan Buttons
				hbox = {
					spacing = 5
					
					# Emphasize Unity Focus
					button_icon_round = {
						# Practical Academia
						size = { 55 55 }
						
						datacontext = "[GetScriptedGui('kog_emphasize_unity_sgui')]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						clicksound = "event:/SFX/kog_focus"
						tooltip = "kog_gui_emphasize_unity"
						blockoverride "icon" {
							texture = "gfx/interface/icons/generic_icons/kog_button_emphasize_unity.dds"
						}
						blockoverride "icon_size" {
							size = { 70% 70% }
						}
					}
					
					# Enforce Attendance Focus
					button_icon_round = {
						# Practical Academia
						size = { 55 55 }
						
						datacontext = "[GetScriptedGui('kog_enforce_attendance_sgui')]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						clicksound = "event:/SFX/kog_focus"
						tooltip = "kog_gui_enforce_attendance"
						blockoverride "icon" {
							texture = "gfx/interface/icons/generic_icons/kog_button_enforce_attendance.dds"
						}
						blockoverride "icon_size" {
							size = { 70% 70% }
						}
					}
					
					# Theologize Dogma Focus
					button_icon_round = {
						# Practical Academia
						size = { 55 55 }
						
						datacontext = "[GetScriptedGui('kog_theologize_dogma_sgui')]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						clicksound = "event:/SFX/kog_focus"
						tooltip = "kog_gui_theologize_dogma"
						blockoverride "icon" {
							texture = "gfx/interface/icons/generic_icons/kog_button_theologize_dogma.dds"
						}
						blockoverride "icon_size" {
							size = { 70% 70% }
						}
					}
					
					# Promote Ecumenism Focus
					button_icon_round = {
						# Practical Academia
						size = { 55 55 }
						
						datacontext = "[GetScriptedGui('kog_promote_ecumenism_sgui')]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						clicksound = "event:/SFX/kog_focus"
						tooltip = "kog_gui_promote_ecumenism"
						blockoverride "icon" {
							texture = "gfx/interface/icons/generic_icons/kog_button_promote_ecumenism.dds"
						}
						blockoverride "icon_size" {
							size = { 70% 70% }
						}
					}
				}
				
				# Current Focus Status
				vbox = {
					background = {
						using = entry_bg
						margin = { 10 10 }
					}
					textbox = {
						text = "kog_gui_metropolitan_focus_header"
						autoresize = yes
						max_width = 250
						elide = right
						using = fontsize_large
					}
					textbox = {
						text = "kog_gui_kog_focus_status"
						autoresize = yes
						max_width = 250
						elide = right
						using = fontsize_medium
					}
				}
				button = { # Commission Icon Button
					using = default_button_primary_big_action
					size = { 240 44 }
					text = "kog_gui_commission_icon"
					using = fontsize_large
					
					datacontext = "[GetScriptedGui('kog_commission_icon_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_commission_icon_desc"
				}
			}
			
			## Authority Actions ##
			vbox = {
				layoutpolicy_horizontal = shrinking
				spacing = 15
				margin = { 10 10 }
				background = {
					using = entry_bg_simple
				}
				
				button = { # Dissolve Monasteries Button
					using = default_button_primary_big_action
					size = { 200 40 }
					text = "kog_gui_dissolve_monasteries"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_dissolve_monasteries_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_dissolve_monasteries_desc"
				}
				
				button = { # Restore Monasteries Button
					using = default_button_primary_big_action
					size = { 200 40 }
					text = "kog_gui_restore_monasteries"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_restore_monasteries_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_restore_monasteries_desc"
				}
				
				button = { # Reform Synod Button
					using = default_button_primary_big_action
					size = { 200 40 }
					text = "kog_gui_reform_synod"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_reform_synod_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_reform_synod_desc"
				}
				
				button = { # Restore Synod Button
					using = default_button_primary_big_action
					size = { 200 40 }
					text = "kog_gui_restore_synod"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_restore_synod_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_restore_synod_desc"
				}
				
				button = { # Grant Subsidies Button
					using = default_button_primary_big_action
					size = { 200 40 }
					text = "kog_gui_grant_subsidies"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_grant_subsidies_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_grant_subsidies_desc"
				}
				
				button = { # End Subsidies Button
					using = default_button_primary_big_action
					size = { 200 40 }
					text = "kog_gui_end_subsidies"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_end_subsidies_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_end_subsidies_desc"
				}
				
				button = { # Establish Schools Button
					using = default_button_primary_big_action
					size = { 200 40 }
					text = "kog_gui_establish_schools"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_establish_schools_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_establish_schools_desc"
				}
				
				button = { # Disband Schools Button
					using = default_button_primary_big_action
					size = { 200 40 }
					text = "kog_gui_disband_schools"
					using = fontsize_medium
					
					datacontext = "[GetScriptedGui('kog_disband_schools_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_disband_schools_desc"
				}
			}
			
			expand = {}
			
		}
	}
	
	type kog_oriental_metropolis_panel = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = shrinking
		using = default_fade_in_out
		maximumsize = { -1 400 }
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "kog_gui_ecclesiastic_header"
			}
		}
		
		hbox = {
			layoutpolicy_vertical = shrinking
			layoutpolicy_horizontal = expanding
			margin_top = 10
			spacing = 5
			
			vbox = {
				margin = { 10 10 }
				spacing = 10
				
				background = {
					using = entry_bg_unit_dark
				}
				
				button = { # Commission Icon Button
					using = default_button_primary_big_action
					size = { 240 44 }
					text = "kog_gui_venerate_apparition"
					using = fontsize_large
					
					datacontext = "[GetScriptedGui('kog_commission_icon_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_venerate_apparation_desc"
				}
			}
		}
	}
	
	type kog_elysian_metropolis_panel = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = shrinking
		using = default_fade_in_out
		maximumsize = { -1 400 }
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "kog_gui_ecclesiastic_header"
			}
		}
		
		hbox = {
			layoutpolicy_vertical = shrinking
			layoutpolicy_horizontal = expanding
			margin_top = 10
			spacing = 5
			
			vbox = {
				margin = { 10 10 }
				spacing = 10
				
				background = {
					using = entry_bg_unit_dark
				}
				
				button = { # Commission Icon Button
					using = default_button_primary_big_action
					size = { 240 44 }
					text = "kog_gui_venerate_apparition"
					using = fontsize_large
					
					datacontext = "[GetScriptedGui('kog_commission_icon_sgui')]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "kog_gui_venerate_apparation_desc"
				}
			}
		}
	}
	
	type metropolitan_stats_entry = widget {
		size = { 200 50 }
		
		divider_clean = {
			parentanchor = bottom
		}
		
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 7
			
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 0 5 }
				
				textbox = {
					layoutpolicy_horizontal = expanding
					size = { 0 16 }
					block "label" {}
					align = right|nobaseline
					elide = right
					fontsize_min = 12
				}
				textbox = {
					layoutpolicy_horizontal = expanding
					size = { 0 20 }
					block "text" {}
					align = right|nobaseline
					elide = right
					fontsize_min = 12
					using = fontsize_medium
				}
			}
			
			block "role_icon" {
				icon = {
					size = { 35 35 }
					block "icon_texture" {}
				}
			}
		}
	}
}