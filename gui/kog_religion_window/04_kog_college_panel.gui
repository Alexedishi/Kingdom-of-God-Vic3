types eocfm_collegium_cardinalium_panels {

	type eocfm_collegium_cardinalium_panel = vbox {
		layoutpolicy_horizontal = preferred
		layoutpolicy_vertical = shrinking
		using = default_fade_in_out
		spacing = 5
		
		visible = "[GetVariableSystem.HasValue('eocfm_metropolitan_tab', 'curia')]"
		
		background = {
			using = entry_bg_unit_dark
			margin = { -10 -5 }
		}
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			blockoverride "text" {
				text = "eocfm_gui_college_header"
			}
		}
		
		# Preferatus
		scrollarea = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			minimumsize = { -1 240 }
			maximumsize = { -1 240 }

			scrollbarpolicy_horizontal = always_off
			scrollbarpolicy_vertical = as_needed

			scrollbar_horizontal = {
				using = horizontal_scrollbar
			}

			scrollbar_vertical = {
				using = vertical_scrollbar
			}
			
			scrollwidget = {
				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 5
					margin = { 0 10 }
					
					datamodel = "[GetGlobalList('eocfm_cardinals_list')]"
					
					item = {
						eocfm_collegium_preferatus_widget = {}
					}
				}
			}
		}
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			maximumsize = { 300 -1 }
			blockoverride "text" {
				text = "eocfm_papabili_header"
			}
		}
		
		# First Row of Candidates
		scrollarea = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			minimumsize = { -1 120 }
			maximumsize = { 600 -1 }

			scrollbarpolicy_horizontal = always_off
			scrollbarpolicy_vertical = as_needed

			scrollbar_horizontal = {
				using = horizontal_scrollbar
			}

			scrollbar_vertical = {
				using = vertical_scrollbar
			}
			
			scrollwidget = {
				
				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 5
					margin = { 0 10 }
					
					datamodel = "[GetGlobalList('eocfm_cardinals_list')]"
					
					item = {
						eocfm_collegium_cardinal_widget = {
							blockoverride "row_visibility" {
								visible = "[Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)2'), Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)3'), EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)4'))))]"
							}
						}
					}
				}
			}
		}
		
		# Second Row of Candidates
		scrollarea = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			minimumsize = { -1 120 }
			maximumsize = { 500 -1 }

			scrollbarpolicy_horizontal = always_off
			scrollbarpolicy_vertical = as_needed

			scrollbar_horizontal = {
				using = horizontal_scrollbar
			}

			scrollbar_vertical = {
				using = vertical_scrollbar
			}
			
			scrollwidget = {
				
				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 5
					margin = { 0 10 }
					
					datamodel = "[GetGlobalList('eocfm_cardinals_list')]"
					
					item = {
						eocfm_collegium_cardinal_widget = {
							blockoverride "row_visibility" {
								visible = "[Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)5'), Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)6'), EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)7')))]"
							}
						}
					}
				}
			}
		}
	}
	
	type eocfm_collegium_preferatus_widget = widget {
		size = { 240 220 }
		using = entry_bg_fancy
		datacontext = "[Scope.GetCharacter]"
		visible = "[EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0')]"
		
		default_header_clean_faded = {
			size = { 220 35 }
			parentanchor = top|hcenter
			blockoverride "text" {
				text = "eocfm_preferatus_header"
				autoresize = yes
				elide = right
				using = fontsize_large
			}
		}
		
		character_portrait_medium_torso = {
			parentanchor = center
			blockoverride "show_hat" {}
			blockoverride "tooltip" {} #TODO Remove when Tooltip doesnt cause error anymore
			blockoverride "portrait_icons" {} #TODO Remove when Tooltip doesnt cause error anymore
			blockoverride "portrait_button" {} #TODO Remove when Tooltip doesnt cause error anymore
		}
		
		default_header_clean_faded = {
			size = { 210 36 }
			parentanchor = bottom|hcenter
			blockoverride "text" {}
		}
		
		textbox = {
			text = "eocfm_cardinal_name"
			parentanchor = bottom|hcenter
			position = { 0 -5 }
			autoresize = yes
			max_width = 250
			elide = right
			using = fontsize_large
		}
		
		textbox = {
			text = "eocfm_cardinal_gravitas"
			parentanchor = top|right
			position = { -10 40 }
			autoresize = yes
			elide = right
			using = fontsize_large
			
			background = {
				using = dark_area
				alpha = 0.5
				margin = { 2 2 }
			}
			
			tooltip = "eocfm_cardinal_gravitas_breakdown"
		}
		
		icon = {
			size = { 48 32 }
			parentanchor = top|left
			position = { 10 39 }
			
			texture = "[Country.GetFlag.GetSmallFlagTexture]"
			alwaystransparent = yes
			
			frame = "[Country.GetFlag.GetSmallFlagFrame]"
			framesize = "[GetSmallFlagFrameSize]"
			
			using = flag_overlay
			
			icon = {
				texture = "gfx/interface/flag/flag_power_small.dds"
				size = { 62 46 }
				framesize = { 124 92 }
				frame = "[Country.GetRankIconIndex]"
				alwaystransparent = yes
				parentanchor = center
			}
		}
	}
	
	type eocfm_collegium_cardinal_widget = widget {
		size = { 140 100 }
		datacontext = "[Scope.GetCharacter]"
		
		block "row_visibility" {}
		
		character_portrait_medium = {
			parentanchor = center
			position = { 0 -10 }
			blockoverride "show_hat" {}
			blockoverride "tooltip" {} #TODO Remove when Tooltip doesnt cause error anymore
			blockoverride "portrait_icons" {} #TODO Remove when Tooltip doesnt cause error anymore
			blockoverride "portrait_button" {} #TODO Remove when Tooltip doesnt cause error anymore
		}
		
		default_header_clean_faded = {
			size = { 110 25 }
			parentanchor = bottom|hcenter
			blockoverride "text" {}
		}
		
		textbox = {
			text = "eocfm_cardinal_name"
			parentanchor = bottom|hcenter
			position = { 0 -2 }
			autoresize = yes
			max_width = 250
			elide = right
			using = fontsize_medium
		}
		
		textbox = {
			text = "eocfm_cardinal_gravitas"
			parentanchor = right|vcenter
			position = { -5 18 }
			autoresize = yes
			elide = right
			using = fontsize_medium
			
			background = {
				using = dark_area
				alpha = 0.5
				margin = { 2 2 }
			}
			
			tooltip = "eocfm_cardinal_gravitas_breakdown"
		}
		
		icon = {
			size = { 27 18 }
			position = { 15 18 }
			parentanchor = left|vcenter
			
			texture = "[Scope.GetCharacter.GetCountry.GetFlag.GetSmallFlagTexture]"
			alwaystransparent = yes
			
			frame = "[Scope.GetCharacter.GetCountry.GetFlag.GetSmallFlagFrame]"
			framesize = "[GetSmallFlagFrameSize]"
			
			using = flag_overlay
			
			icon = {
				name = frame
				texture = "gfx/interface/flag/flag_power_tiny.dds"
				size = { 33 24 }
				framesize = { 66 48 }
				frame = "[Country.GetRankIconIndex]"
				alwaystransparent = yes
				parentanchor = center
				block "visibility" {}
			}
		}
	}
}