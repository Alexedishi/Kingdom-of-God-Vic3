types kog_episcopal_seat_panels {
	type kog_seat_tab_buttons = vbox {
		margin = { 5 5 }
		spacing = 5
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		
		hbox = {
			margin = { 3 0 }
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = fixed
			
			### START DIVIDER
			icon = {
				texture = "gfx/interface/tabs/tab_divider.dds"
				layoutpolicy_horizontal = fixed
				layoutpolicy_vertical = expanding
				size = { 5 -1 }
				spriteType = Corneredstretched
				spriteborder = { 0 20 }
			}
			
			# Catholicism Tab
			tab_button = {
				layoutstretchfactor_horizontal = 1
				layoutpolicy_horizontal = preferred
				
				textbox = {
					text = "kog_gui_catholic_tab"
					default_format = "#title"
					using = tab_text_properties
				}
				
				visible = "[Not(GetVariableSystem.HasValue( 'kog_tabs_var', 'kog_tab_catholic' ))]"
				onclick = "[GetVariableSystem.Set('kog_tabs_var', 'kog_tab_catholic')]"
			}
			icon = {
				layoutstretchfactor_horizontal = 1
				layoutpolicy_horizontal = preferred
				using = selected_tabs
				
				textbox = {
					text = "kog_gui_catholic_tab_selected"
					default_format = "#title"
					using = tab_text_properties
				}
				
				visible = "[GetVariableSystem.HasValue( 'kog_tabs_var', 'kog_tab_catholic' )]"
			}
			
			# Eastern Orthodoxy Tab
			tab_button = {
				layoutstretchfactor_horizontal = 1
				layoutpolicy_horizontal = preferred
				
				textbox = {
					block "first_button" {
						text = "eocgm_gui_orthodox_tab"
					}
					default_format = "#title"
					using = tab_text_properties
				}
				visible = "[Not(GetVariableSystem.HasValue( 'kog_tabs_var', 'kog_tab_orthodox' ))]"
				onclick = "[GetVariableSystem.Set('kog_tabs_var', 'kog_tab_orthodox')]"
				
			}
			icon = {
				layoutstretchfactor_horizontal = 1
				layoutpolicy_horizontal = preferred
				using = selected_tabs
				
				textbox = {
					text = "eocgm_gui_orthodox_tab_selected"
					default_format = "#title"
					using = tab_text_properties
				}
				
				visible = "[GetVariableSystem.HasValue( 'kog_tabs_var', 'kog_tab_orthodox' )]"
			}
			
			# Oriental Orthodoxy Tab
			tab_button = {
				layoutstretchfactor_horizontal = 1
				layoutpolicy_horizontal = preferred
				
				textbox = {
					block "first_button" {
						text = "kog_gui_oriental_tab"
					}
					default_format = "#title"
					using = tab_text_properties
				}
				visible = "no"
				#visible = "[Not(GetVariableSystem.HasValue( 'kog_tabs_var', 'kog_tab_oriental' ))]"
				onclick = "[GetVariableSystem.Set('kog_tabs_var', 'kog_tab_oriental')]"
			}
			icon = {
				layoutstretchfactor_horizontal = 1
				layoutpolicy_horizontal = preferred
				using = selected_tabs
				
				textbox = {
					text = "kog_gui_oriental_tab_selected"
					default_format = "#title"
					using = tab_text_properties
				}
				visible = "no"
				#visible = "[GetVariableSystem.HasValue( 'kog_tabs_var', 'kog_tab_oriental' )]"
			}
			
			# Elysian Orthodoxy
			tab_button = {
				layoutstretchfactor_horizontal = 1
				layoutpolicy_horizontal = preferred
				visible = "no"
				#visible = "[GetScriptedGui('kog_basileia_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[GetVariableSystem.Set('kog_tabs_var', 'kog_tab_elysian')]"
				
				textbox = {
					block "first_button" {
						text = "kog_gui_elysian_tab"
					}
					default_format = "#title"
					using = tab_text_properties
				}
				
			}
			icon = {
				layoutstretchfactor_horizontal = 1
				layoutpolicy_horizontal = preferred
				using = selected_tabs
				
				textbox = {
					text = "kog_gui_elysian_tab_selected"
					default_format = "#title"
					using = tab_text_properties
				}
				visible = "no"
				#visible = "[GetVariableSystem.HasValue( 'kog_tabs_var', 'kog_tab_elysian' )]"
			}
		}
	}

	type kog_catholic_seats = scrollarea {
		visible = "[GetVariableSystem.HasValue( 'kog_tabs_var', 'kog_tab_catholic' )]"
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		
		scrollbarpolicy_horizontal = always_off
		
		scrollbar_vertical = {
			using = vertical_scrollbar
		}
		
		scrollwidget = {
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10
				
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_rome').GetCharacter]"
					}
					blockoverride "patriarch_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_rome').Var('kog_patriarch_var').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_santiago').GetCharacter]"
					}
					blockoverride "patriarch_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_santiago').Var('kog_patriarch_var').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_paris').GetCharacter]"
					}
					blockoverride "patriarch_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_paris').Var('kog_patriarch_var').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_koln').GetCharacter]"
					}
					blockoverride "patriarch_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_koln').Var('kog_patriarch_var').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_vienna').GetCharacter]"
					}
					blockoverride "patriarch_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_vienna').Var('kog_patriarch_var').GetCharacter]"
					}
				}
			}
		}
	}
	
	type kog_orthodox_seats = scrollarea {
		visible = "[GetVariableSystem.HasValue( 'kog_tabs_var', 'kog_tab_orthodox' )]"
		
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		
		scrollbarpolicy_horizontal = always_off
		
		scrollbar_vertical = {
			using = vertical_scrollbar
		}
		
		scrollwidget = {
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10
				
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_constantinople').GetCharacter]"
					}
					blockoverride "patriarch_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_constantinople').Var('kog_patriarch_var').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_antioch').GetCharacter]"
					}
					blockoverride "patriarch_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_antioch').Var('kog_patriarch_var').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_jerusalem').GetCharacter]"
					}
					blockoverride "patriarch_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_jerusalem').Var('kog_patriarch_var').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_alexandria').GetCharacter]"
					}
					blockoverride "patriarch_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_alexandria').Var('kog_patriarch_var').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_moscow').GetCharacter]"
					}
					blockoverride "patriarch_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_moscow').Var('kog_patriarch_var').GetCharacter]"
					}
				}
			}
		}
	}
	
	type kog_oriental_seats = scrollarea {
		visible = "[GetVariableSystem.HasValue( 'kog_tabs_var', 'kog_tab_oriental' )]"
		
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		
		scrollbarpolicy_horizontal = always_off
		
		scrollbar_vertical = {
			using = vertical_scrollbar
		}
		
		scrollwidget = {
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10
				
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_coptic_alexandria').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_syriac_antioch').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_etchmiadzin').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_addis_ababa').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_konak').GetCharacter]"
					}
				}
			}
		}
	}
	
	type kog_elysian_seats = scrollarea {
		visible = "[GetVariableSystem.HasValue( 'kog_tabs_var', 'kog_tab_elysian' )]"
		
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		
		scrollbarpolicy_horizontal = always_off
		
		scrollbar_vertical = {
			using = vertical_scrollbar
		}
		
		scrollwidget = {
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10
				
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_elysium').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_mixtec').GetCharacter]"
					}
				}
				kog_episcopal_seat = {
					blockoverride "seat_visibility" {
						visible = "[GetScriptedGui('kog_cahokia_founding_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
					blockoverride "seat_datacontext" {
						datacontext = "[GetGlobalVariable('kog_global').Var('kog_cahokia').GetCharacter]"
					}
				}
			}
		}
	}
	
	type kog_episcopal_seat = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 10
		margin = { -10 10 }
		block "seat_visibility" {}
		block "seat_datacontext" {}
		
		background = {
			using = entry_bg
		}
		
		default_header_clean_faded = {
			layoutpolicy_horizontal = expanding
			size = { 0 40 }
			blockoverride "text" {
				text = "[Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_name'))]"
			}
		}
		
		## Character Portrait
		hbox = {
			layoutpolicy_horizontal = expanding
			
			character_portrait_medium = {
				block "patriarch_datacontext" { }
				blockoverride "show_hat" { }
				blockoverride "tooltip" { } # Error Suppression
				blockoverride "portrait_icons" { } # Error Suppression
				blockoverride "portrait_button" { } # Error Suppression
				
				default_header_clean_faded = {
					size = { 150 35 }
					position = { 0 80 }
					parentanchor = center
					blockoverride "text" {
					}
					textbox = {
						text = "kog_gui_patriarch_name"
						parentanchor = center
						position = { 0 -2 }
						autoresize = yes
						max_width = 190
						elide = right
						using = fontsize_medium
					}
				}
			}
			
			widget = {
				size = { 150 150 }
				
				background = {
					using = entry_bg_simple
				}
				textbox = {
					text = "kog_gui_liturgical_rite"
					size = { 150 40 }
					elide = right
					using = fontsize_medium
				}
				textbox = {
					text = "kog_gui_location"
					size = { 150 40 }
					elide = right
					using = fontsize_medium
				}
				textbox = {
					text = "kog_gui_opinion"
					size = { 150 40 }
					elide = right
					using = fontsize_medium
				}
			}
		}
		
		hbox = {
			layoutpolicy_horizontal = shrinking
			layoutpolicy_vertical = shrinking
			background = {
				using = entry_bg_unit_dark
			}
			
			# Integrate Seat Button
			button = {
				using = default_button_action
				size = { 150 40 }
				text = "kog_gui_integrate_seat"
				using = fontsize_small
				
				datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_integrate_sgui')))]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "kog_gui_integrate_seat_desc"
			}
			
			# Integration Progressbar
			green_progressbar_horizontal = {
				size = { 140 20 }
				visible = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_integration_sgui'))).IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
				
				blockoverride "values" {
					min = 0
					max = 120
					value = "[Character.MakeScope.Var('kog_integration_var').GetValue]"
				}
				textbox = {
					parentanchor = center
					autoresize = yes
					
					text = "kog_gui_integration_progress"
					elide = right
					using = fontsize_small
				}
			}
			
			# Enforce Rite Button
			button = {
				using = default_button_action
				size = { 150 40 }
				text = "kog_gui_enforce_seat"
				using = fontsize_small
				
				datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_enforce_sgui')))]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "kog_gui_enforce_seat_desc"
			}
			
			# Enforcement Progressbar
			green_progressbar_horizontal = {
				size = { 140 20 }
				visible = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_enforcement_sgui'))).IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
				
				blockoverride "values" {
					min = 0
					max = 120
					value = "[Character.MakeScope.Var('kog_enforcement_var').GetValue]"
				}
				textbox = {
					parentanchor = center
					autoresize = yes
					
					text = "kog_gui_enforcement_progress"
					elide = right
					using = fontsize_small
				}
			}
			
			# Improve Relations Button
			button = {
				using = default_button_action
				size = { 150 40 }
				text = "kog_gui_improve_relations"
				using = fontsize_small
				
				datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_start_sway_sgui')))]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "kog_gui_improve_relations_desc"
			}
			
			# Cease Diplomacy Button
			button = {
				using = default_button_action
				size = { 150 40 }
				text = "kog_gui_cease_diplomacy"
				using = fontsize_small
				
				datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_stop_sway_sgui')))]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "kog_gui_cease_diplomacy_desc"
			}
			
			# Damage Relations Button
			button = {
				using = default_button_action
				size = { 150 40 }
				text = "kog_gui_damage_relations"
				using = fontsize_small
				
				datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_start_harm_sgui')))]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "kog_gui_damage_relations_desc"
			}
			
			# Cease Hostilities Button
			button = {
				using = default_button_action
				size = { 150 40 }
				text = "kog_gui_cease_hostilities"
				using = fontsize_small
				
				datacontext = "[GetScriptedGui(Localize(Concatenate(Character.MakeScope.Var('kog_seat_id').GetFlagName, '_stop_harm_sgui')))]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "kog_gui_cease_hostilities_desc"
			}
		}
		
		expand = {}
	}
}