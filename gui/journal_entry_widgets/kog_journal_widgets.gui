	type kog_ecumenical_council_debate_item = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		margin_left = 10
		spacing = 5
		
		block "council_debate_item_visibility" {
			visible = no
		}
		
		default_header_clean_faded = {
			parentanchor = hcenter
			blockoverride "text" {
				block "canon_law_group_name" {
					raw_text = "#todo canon_law_group_name"
					using = look_at_me_text_animation
				}
			}
			blockoverride "size" {
				size = { 532 45 }
			}
		}
		
		flowcontainer = {
			parentanchor = top|left
			minimumsize = { 520 50 }
			spacing = 10
			
			block "canon_law_1_visibility" {
				visible = no
			}
			
