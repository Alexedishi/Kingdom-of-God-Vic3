	type kog_metropolitan_focus_button = button_icon_round {
		parentanchor = center
		size = { 55 55 }
		
		enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
		onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
		blockoverride "sound" {
			clicksound = "event:/SFX/kog/kog_focus"
		}
		tooltip = "kog_gui_focus_button_tooltip"
		
		icon = {
			visible = "[ScriptedButton.IsSelected]"
			using = rotate_glow_animation_02
			size = { 90 90 }
			alwaystransparent = yes
			parentanchor = center
			using = default_fade_in_out
		}
		
		textbox = {
			parentanchor = center
			align = nobaseline
			autoresize = yes
			max_width = 50
			elide = right
			using = fontsize_small
			text = "[ScriptedButton.GetName]"
		}
	}
	
	type kog_metropolitan_actions_container = flowcontainer {
