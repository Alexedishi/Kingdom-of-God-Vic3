				max_width = 165
				elide = right
				fontsize = 13
				using = tooltip_font
				text = "kog_gui_antagonize_seat"
			}
		}
		
		# Stop Antagonizing
		button = {
			size = { 174 38 }
			using = default_button_action
			datacontext = "[GetScriptedGui('kog_stop_antagonize_sgui')]"
			visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('kog_episcopal_seat_scope', ScriptContainer.MakeScope).End)]"
			enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('kog_episcopal_seat_scope', ScriptContainer.MakeScope).End)]"
