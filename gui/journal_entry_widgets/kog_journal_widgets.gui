		dynamicgridbox = {
			parentanchor = center
			layoutpolicy_vertical = preferred
			datamodel = "[Character.AccessTraits]"
			datamodel_wrap = 3
			flipdirection = yes
			
			background = {
				using = dark_area
				alpha = 0.25
			}
			
			item = {
				flowcontainer = {
					margin = { 5 5 }
					alpha = "[TransparentIfTrue(CharacterTrait.IsDisabled)]"
					
					tooltipwidget = {
						FancyTooltip_CharacterTrait = { }
					}
					icon = {
						size = { 32 45 }
						texture = "[CharacterTrait.GetTexture]"
					}
				}
			}
		}
	}
}

types kog_episcopal_seats_panel_types {
	type kog_episcopal_seats_panel = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 540 -1 }
		spacing = 10
		margin = { 0 10 }
		
		visible = "[And(
			DataModelHasItems(JournalEntry.MakeScope.GetList('kog_seats_list')),
			GetVariableSystem.HasValue('kog_denominational_tab', 'seats')
		)]"
		
		datamodel = "[JournalEntry.MakeScope.GetList('kog_seats_list')]"
		
		item = {
			kog_episcopal_seat_item = { }
		}
		
	}
	
	type kog_episcopal_seat_item = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 540 -1 }
		
		datacontext = "[Scope.GetScriptContainer]"
		
		background = {
			texture = "gfx/interface/illustrations/holy_sites/ck3_temple_generic_grass.dds"
			fittype = centercrop
			using = frame_small_mask
			alpha = 0.5
		}
		
		background = {
			texture = "gfx/interface/backgrounds/subject_liberty_desire_frame.dds"
		}
		
		## SEAT HEADER TEXT
		widget = {
			parentanchor = top|hcenter
			size = { 530 40 }
			
			background = {
				using = default_header_bg
				modify_texture = {
					texture = "gfx/interface/masks/fade_horizontal_center.dds"
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = alphamultiply
					alpha = 0.95
				}
			}
			
			background = {
				using = dark_area
				alpha = 0.2
				margin = { 3 -5 }
			}
			
			textbox = {
				minimumsize = { 265 35 }
				position = { 10 0 }
				text = "kog_gui_seat_name"
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 265
				elide = right
				align = left|nobaseline
				using = fontsize_large
			}
			
			textbox = {
				minimumsize = { 265 35 }
				position = { -10 0 }
				text = "kog_gui_seat_controller"
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 265
				align = right|nobaseline
				elide = right
				using = fontsize_medium
			}
		}
		
		## SEAT CONTAINER DETAILS
		flowcontainer = {
			parentanchor = top|hcenter
			direction = horizontal
			minimumsize = { 540 -1 }
			margin_left = 10
			margin_bottom = 10
			spacing = 5
			
			## PATRIARCH PORTRAIT
			widget = {
				parentanchor = left|top
				size = { 110 95% }
				
				background = {
					using = dark_area
				}
				
				kog_episcopal_seat_portrait = {
					parentanchor = top|hcenter
					position = { 0 10 }
					datacontext = "[ScriptContainer.MakeScope.Var('kog_patriarch_var').GetCharacter]"
					blockoverride "show_hat" { }
					blockoverride "tooltip" { } # Error Suppression
					blockoverride "portrait_icons" { } # Error Suppression
					blockoverride "portrait_button" { } # Error Suppression
					
					default_header_clean_faded = {
						size = { 150 35 }
						position = { 0 80 }
						parentanchor = center
						blockoverride "text" { }
						visible = "no"
						textbox = {
							text = "kog_gui_patriarch_name"
							parentanchor = center
							position = { 0 0 }
							autoresize = yes
							max_width = 190
							elide = right
							using = fontsize_medium
						}
					}
				}
				
				# Opinion
				textbox = {
					text = "kog_gui_opinion"
					parentanchor = bottom|hcenter
					position = { 0 -5 }
					max_width = 100
					multiline = yes
					autoresize = yes
					elide = right
					align = center|nobaseline
					using = fontsize_medium
				}
			}
			
			## STATISTICS
			flowcontainer = {
				parentanchor = top|hcenter
				direction = vertical
				minimumsize = { 220 135 }
				spacing = 5
				margin = { 10 10 }
				
				background = {
					using = entry_bg_simple_solid
				}
				
				# Seat Location
				textbox = {
					datacontext = "[ScriptContainer.MakeScope.Var('kog_patriarch_var').GetCharacter]"
					parentanchor = left|vcenter
					text = "kog_gui_patriarch_name"
					size = { 170 20 }
					elide = right
					using = fontsize_medium
				}
				divider_clean = {
					parentanchor = center
				}
				
				# Liturgical Language
				textbox = {
					parentanchor = left|vcenter
					text = "kog_gui_seat_location"
					size = { 170 20 }
					elide = right
					using = fontsize_medium
				}
				divider_clean = {
					parentanchor = center
				}
				
				# Liturgical Rite
				textbox = {
					parentanchor = left|vcenter
					text = "kog_gui_liturgical_language"
					size = { 170 20 }
					elide = right
					using = fontsize_medium
				}
				divider_clean = {
					parentanchor = center
				}
				
				# Opinion
				textbox = {
					parentanchor = left|vcenter
					text = "kog_gui_liturgical_rite"
					size = { 170 20 }
					elide = right
					using = fontsize_medium
				}
			}
			
			## SCRIPTED BUTTONS
			kog_seat_scripted_button_container = { }
		}
	}
	
	type kog_episcopal_seat_portrait = character_portrait_base_head {
		size = { 80 80 }
		blockoverride "portrait_size" {
			size = { 80 88 }
		}
		blockoverride "icon_size" {
			size = { 34 34 }
		}
		
		blockoverride "rank_icon" {
			rank_icon = {
				visible = "[Character.IsCommander]"
				parentanchor = bottom|right
				blockoverride "icon_size" {
					size = { 30 30 }
				}
			}
		}
		
		blockoverride "additional_icons" {
			block "ig_button" {
				ig_button = {
					datacontext = "[Character.AccessInterestGroup]"
					size = { 30 30 }
					parentanchor = bottom
					using = tooltip_se
					blockoverride "in_government_icon" { }
				}
			}
		}
	}
	
	type kog_seat_scripted_button_container = flowcontainer {
		parentanchor = right|top
		direction = vertical
		minimumsize = { 180 135 }
		maximumsize = { 180 160 }
		margin = { 10 10 }
		spacing = 10
		
		background = {
			using = entry_bg
		}
		
		## General Actions
		flowcontainer = {
			direction = horizontal
			spacing = 5
			
			# Start Swaying
			kog_episcopal_seat_button = {
				blockoverride "button_datacontext" {
					datacontext = "[GetScriptedGui('kog_start_sway_sgui')]"
				}
				blockoverride "button_tooltip" {
					tooltip = "kog_gui_sway_seat_desc"
				}
				blockoverride "button_icon_texture" {
					texture = "gfx/interface/icons/scripted_actions/kog_increase_relations.dds"
				}
			}
			
			# Stop Swaying
			kog_episcopal_seat_button = {
				blockoverride "button_datacontext" {
					datacontext = "[GetScriptedGui('kog_stop_sway_sgui')]"
				}
				blockoverride "button_tooltip" {
					tooltip = "kog_gui_sway_seat_desc"
				}
				blockoverride "button_icon_texture" {
					texture = "gfx/interface/icons/scripted_actions/kog_increase_relations.dds"
				}
			}
			
			# Start Antagonizing
			kog_episcopal_seat_button = {
				blockoverride "button_datacontext" {
					datacontext = "[GetScriptedGui('kog_start_antagonize_sgui')]"
				}
				blockoverride "button_tooltip" {
					tooltip = "kog_gui_antagonize_seat_desc"
				}
				blockoverride "button_icon_texture" {
					texture = "gfx/interface/icons/scripted_actions/kog_damage_relations.dds"
				}
			}
			
			# Stop Antagonizing
			kog_episcopal_seat_button = {
				blockoverride "button_datacontext" {
					datacontext = "[GetScriptedGui('kog_stop_antagonize_sgui')]"
				}
				blockoverride "button_tooltip" {
					tooltip = "kog_gui_antagonize_seat_desc"
				}
				blockoverride "button_icon_texture" {
					texture = "gfx/interface/icons/scripted_actions/kog_damage_relations.dds"
				}
			}
			
			# Integrate Seat
			kog_episcopal_seat_button = {
				blockoverride "button_datacontext" {
					datacontext = "[GetScriptedGui('kog_integrate_seat_sgui')]"
				}
				blockoverride "button_tooltip" {
					tooltip = "kog_gui_integrate_seat_desc"
				}
				blockoverride "button_icon_texture" {
					texture = "gfx/interface/icons/scripted_actions/kog_integrate_seat.dds"
				}
			}
			
			# Assert Seat
			kog_episcopal_seat_button = {
				blockoverride "button_datacontext" {
					datacontext = "[GetScriptedGui('kog_assert_seat_sgui')]"
				}
				blockoverride "button_tooltip" {
					tooltip = "kog_gui_sway_seat_desc"
				}
				blockoverride "button_icon_texture" {
					texture = "gfx/interface/icons/scripted_actions/kog_integrate_seat.dds"
				}
			}
			
			# Enforce Rite
			kog_episcopal_seat_button = {
				blockoverride "button_datacontext" {
					datacontext = "[GetScriptedGui('kog_enforce_seat_sgui')]"
				}
				blockoverride "button_tooltip" {
					tooltip = "kog_gui_sway_seat_desc"
				}
				blockoverride "button_icon_texture" {
					texture = "gfx/interface/icons/scripted_actions/kog_enforce_rite.dds"
				}
			}
		}
		
		## Major Actions
		flowcontainer = {
			direction = horizontal
			spacing = 5
			
			kog_episcopal_seat_button = {
				blockoverride "button_icon_texture" {
					texture = "gfx/interface/icons/scripted_actions/kog_make_offer.dds"
				}
			}
			kog_episcopal_seat_button = {
				blockoverride "button_icon_texture" {
					texture = "gfx/interface/icons/scripted_actions/kog_install_bishop.dds"
				}
			}
			kog_episcopal_seat_button = {
				blockoverride "button_icon_texture" {
					texture = "gfx/interface/icons/scripted_actions/kog_transfer_seat.dds"
				}
			}
		}
	}
	
	type kog_episcopal_seat_button = button {
		size = { 50 50 }
		block "button_datacontext" {
			datacontext = "[GetScriptedGui('kog_placeholder_sgui')]"
		}
		
		using = default_button_action
		
		visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('kog_episcopal_seat_scope', ScriptContainer.MakeScope).End)]"
		enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('kog_episcopal_seat_scope', ScriptContainer.MakeScope).End)]"
		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('kog_episcopal_seat_scope', ScriptContainer.MakeScope).End)]"
		
		block "button_tooltip" {
			tooltip = "kog_placeholder_text"
		}
		
		icon = {
			parentanchor = center
			size = { 40 40 }
			block "button_icon_texture" {
				texture = "gfx/interface/icons/generic_icons/maybe_icon.dds"
			}
		}
	}
}

types kog_crusade_panel_types {
	type kog_crusade_panel = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
	}
}