	type kog_holy_site_item = widget {
		size = { 520 120 }
		parentanchor = top|hcenter
		
		using = entry_bg_fancy
		
		background = {
			block "holy_site_background" {
				texture = "gfx/interface/illustrations/holy_sites/ck3_temple_generic_grass.dds"
			}
			fittype = centercrop
			using = frame_small_mask
			alpha = 0.75
