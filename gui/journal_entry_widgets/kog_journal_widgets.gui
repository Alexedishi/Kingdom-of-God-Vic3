	type kog_canon_law_group_entry = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }
		spacing = 5
		margin_left = 10
		margin_bottom = 10
		
		using = entry_bg_fancy
		
		background = {
			block "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/placeholder.dds"
			}
			size = { 100% 100% }
			fittype = centercrop
			spriteborder = { 0 20 }
			margin = { -5 -3 }
			
			modify_texture = {
				texture = "gfx/interface/illustrations/canon_laws/canon_law_image_mask.dds"
				spriteType = Corneredstretched
				blend_mode = alphamultiply
				texture_density = 2
			}
		}
		
		default_header_clean_faded = {
			parentanchor = top|hcenter
			size = { 500 40 }
			blockoverride "text" {
			}
			textbox = {
				block "canon_law_group_name" {
					text = "kog_block_canon_law_group"
					using = look_at_me_text_animation
				}
				parentanchor = center
				position = { 0 0 }
				autoresize = yes
				max_width = 520
				elide = right
				fontsize = 18
			}
		}
		
		## Top Row - Active Doctrine + Debate Button
		flowcontainer = {
			parentanchor = top|hcenter
			direction = horizontal
			minimumsize = { 500 -1 }
			spacing = 5
			
			widget = {
				parentanchor = left|vcenter
				size = { 320 35 }
				
				textbox = {
					parentanchor = left|vcenter
					size = { 340 35 }
					position = { 5 -5 }
					
					block "active_canon_law_flag" {
						text = "kog_block_canon_law_flag"
						using = look_at_me_text_animation
					}
					autoresize = yes
					max_width = 290
					elide = right
					using = fontsize_large
				}
			}
			
			flowcontainer = {
				parentanchor = top|hcenter
				minimumsize = { 180 -1 }
				
				direction = vertical
				datamodel = "[JournalEntry.GetScriptedButtons]"
				
				item = {
					kog_canon_law_group_debate_button = { }
				}
			}
		}
		
		## Lower Row - Canon Law Types
		flowcontainer = {
			parentanchor = top|hcenter
			direction = horizontal
			minimumsize = { 500 -1 }
			spacing = 10
			
			datamodel = "[JournalEntry.GetScriptedButtons]"
			
			background = {
				using = dark_area
				margin = { 5 5 }
			}
			
			item = {
				kog_canon_law_type_button = { }
			}
		}
	}
	
	type kog_canon_law_group_debate_button = widget {
		parentanchor = top|hcenter
		size = { 180 40 }
		
		block "canon_law_debate_tag" {
			visible = "[ScriptedButton.HasTag('hidden_button')]"
		}
		
		button = {
			parentanchor = center
			size = { 180 40 }
			position = { -5 -5 }
			using = default_button_action
			tooltip = "SCRIPTED_ACTION_TOOLTIP"
			enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
			onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
			
			widget = {
				parentanchor = center
				visible = "[ScriptedButton.IsSelected]"
				size = { 100% 100% }
				
				background = {
					using = paper_bg
				}
			}
			
			textbox = {
				parentanchor = center
				align = nobaseline
				autoresize = yes
				max_width = 200
				elide = right
				fontsize = 18
				text = "kog_gui_debate_canon_law"
			}
			
			icon = {
				parentanchor = center
				visible = "[ScriptedButton.IsSelected]"
				using = highlighted_square_selection
			}
		}
	}
	
	type kog_canon_law_type_button = button {
		parentanchor = center
		size = { 35 35 }
		
		block "canon_law_button_tag" {
			visible = "[ScriptedButton.HasTag('hidden_button')]"
		}
		
		icon = {
			visible = "[ScriptedButton.IsSelected]"
			using = rotate_glow_animation_02
			size = { 90 90 }
			alwaystransparent = yes
			parentanchor = center
			using = default_fade_in_out
		}
		icon = {
			parentanchor = center
			size = { 35 35 }
			texture = "gfx/interface/backgrounds/round_button_bg.dds"
			
			icon = {
				parentanchor = center
				texture = "[ScriptedButton.GetIcon]"
				size = { 80% 80% }
			}
		}
		tooltip = SCRIPTED_ACTION_TOOLTIP
	}
}

types kog_collegium_panel_types {
	type kog_collegium_panel = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		
		visible = "[And(
			DataModelHasItems(GetGlobalList('kog_cardinals_list')),
			GetVariableSystem.HasValue('kog_denominational_tab', 'curia')
		)]"
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			minimumsize = { 520 -1 }
			spacing = 0
			margin_bottom = 15
			
			using = entry_bg_fancy
			
			default_header_clean_faded = {
				parentanchor = top|hcenter
				blockoverride "text" {
					text = "kog_gui_papabili_header"
				}
				blockoverride "size" {
					size = { 532 45 }
				}
			}
			
			flowcontainer = {
				parentanchor = top|hcenter
				direction = horizontal
				minimumsize = { 520 -1 }
				spacing = 5
				margin_left = 8
				
				background = {
					texture = "gfx/interface/illustrations/journal_backgrounds/kog_church_hallway_illus.dds"
					fittype = centercrop
					alpha = 0.75
					margin = { 0 5 }
					
					modify_texture = {
						texture = "gfx/interface/backgrounds/default_bg_shading.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = overlay
					}
					modify_texture = {
						using = texture_velvet
					}
					modify_texture = {
						texture = "gfx/interface/masks/fade_vertical_center.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 10 }
						blend_mode = alphamultiply
						alpha = 0.75
					}
					
				}
				
				## RANK 2
				kog_collegium_papabili_widget = {
					blockoverride "papabile_datacontext" {
						datacontext = "[Scope.GetCharacter]"
						datacontext_from_model = {
							datamodel = "[GetGlobalList('kog_cardinals_list')]"
							index = 1
						}
					}
					blockoverride "pababile_pose" {
						portrait_texture = "[Character.GetAnimatedPortrait(
							'ruler_environment',
							'camera_leader',
							'commander_vs_left',
							GetPortraitRenderSize(PdxGuiWidget.Self))
						]"
					}
				}
				
				## RANK 1
				kog_collegium_papabili_widget = {
					blockoverride "papabile_title_text" {
						raw_text = "#bold [concept_preferatus]"
					}
					blockoverride "papabile_chad_factor" {
						size = { 230 230 }
					}
					blockoverride "papabile_datacontext" {
						datacontext = "[Scope.GetCharacter]"
						datacontext_from_model = {
							datamodel = "[GetGlobalList('kog_cardinals_list')]"
							index = 0
						}
					}
					blockoverride "pababile_pose" {
						portrait_texture = "[Character.GetAnimatedPortrait(
							'ruler_environment',
							'camera_leader',
							'commander_vs_left',
							GetPortraitRenderSize(PdxGuiWidget.Self))
						]"
					}
					
					blockoverride "pababile_pose" {
						portrait_texture = "[Character.GetAnimatedPortrait(
							'ruler_environment',
							'camera_leader',
							'idle',
							GetPortraitRenderSize(PdxGuiWidget.Self))
						]"
					}
				}
				
				## RANK 3
				kog_collegium_papabili_widget = {
					blockoverride "papabile_datacontext" {
						datacontext = "[Scope.GetCharacter]"
						datacontext_from_model = {
							datamodel = "[GetGlobalList('kog_cardinals_list')]"
							index = 2
						}
					}
					blockoverride "pababile_pose" {
						portrait_texture = "[Character.GetAnimatedPortrait(
							'ruler_environment',
							'camera_leader',
							'commander_vs_left',
							GetPortraitRenderSize(PdxGuiWidget.Self))
						]"
					}
					blockoverride "pababile_pose" {
						portrait_texture = "[Character.GetAnimatedPortrait(
							'ruler_environment',
							'camera_leader',
							'commander_vs_right',
							GetPortraitRenderSize(PdxGuiWidget.Self))
						]"
					}
				}
			}
		}
		
		## CARDINAL LIST TOGGLE
		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "kog_gui_cardinals_list"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('kog_collegium_toggle')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('kog_collegium_toggle'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('kog_collegium_toggle')]"
			}
		}
		
		## CARDINAL LIST CONTAINER
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			visible = "[GetVariableSystem.Exists('kog_collegium_toggle')]"
			
			datamodel = "[GetGlobalList('kog_cardinals_list')]"
			
			item = {
				kog_collegium_cardinal_widget = { }
			}
		}
	}
	
	type kog_collegium_papabili_widget = widget {
		parentanchor = top|hcenter
		size = { 165 190 }
		
		icon = {
			parentanchor = center
			position = { 0 15 }
			scale = 0.25
