		flowcontainer = {
			parentanchor = top|hcenter
			direction = horizontal
			minimumsize = { 540 40 }
			margin = { 15 0 }
			
			background = {
				using = default_header_bg_faded
			}
			
			widget = {
				parentanchor = center
				size = { 400 40 }
				
				textbox = {
					parentanchor = left|vcenter
					block "kog_seat_name" {
						text = "kog_gui_seat_name"
						using = look_at_me_text_animation
					}
					autoresize = yes
					elide = right
					using = fontsize_large
				}
			}
			widget = {
				parentanchor = center
				size = { 120 40 }
				
				textbox = {
					parentanchor = right|vcenter
					block "episcopal_seat_controller" {
						text = "kog_gui_seat_controller"
						using = look_at_me_text_animation
					}
					autoresize = yes
					elide = right
					using = fontsize_medium
				}
			}
		}
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = horizontal
			spacing = 5
			minimumsize = { 540 -1 }
			
			widget = {
				parentanchor = left|vcenter
				size = { 145 160 }
				
				character_portrait_medium_torso = {
					parentanchor = center
					block "episcopal_seat_patriarch_datacontext" {
						datacontext = "[GetPlayer.GetRuler]"
					}
					blockoverride "show_hat" { }
					blockoverride "tooltip" { } # Error Suppression
					blockoverride "portrait_icons" { } # Error Suppression
					blockoverride "portrait_button" { } # Error Suppression
					
					default_header_clean_faded = {
						size = { 150 35 }
						position = { 0 80 }
						parentanchor = center
						blockoverride "text" {}
						textbox = {
							block "episcopal_seat_patriarch_name" {
								text = "kog_gui_patriarch_name"
							}
							parentanchor = center
							position = { 0 -2 }
							autoresize = yes
							max_width = 190
							elide = right
							using = fontsize_medium
						}
					}
				}
			}
			
			widget = {
				parentanchor = top|hcenter
				size = { 180 180 }
				
				background = {
					using = entry_bg_simple
				}
				
				flowcontainer = {
					parentanchor = center
					direction = vertical
					maximumsize = { 180 180 }
					spacing = 5
					margin_left = 8
					
					# Seat Location
					textbox = {
						parentanchor = left|vcenter
						text = "kog_gui_seat_location_header"
						size = { 170 20 }
						elide = right
						using = fontsize_medium
					}
					textbox = {
						parentanchor = left|vcenter
						block "episcopal_seat_location" {
							text = "kog_gui_seat_location_value"
							using = look_at_me_text_animation
						}
						size = { 170 20 }
						elide = right
						using = fontsize_medium
					}
					divider_clean = {
						parentanchor = center
					}
					
					# Liturgical Language
					textbox = {
						parentanchor = left|vcenter
						text = "kog_gui_liturgical_language_header"
						size = { 170 20 }
						elide = right
						using = fontsize_medium
					}
					textbox = {
						parentanchor = left|vcenter
						block "episcopal_seat_liturgical_language" {
							text = "kog_gui_liturgical_language_value"
							using = look_at_me_text_animation
						}
						size = { 170 20 }
						elide = right
						using = fontsize_medium
					}
					divider_clean = {
						parentanchor = center
					}
					
					# Liturgical Rite
					textbox = {
						parentanchor = left|vcenter
						text = "kog_gui_liturgical_rite_header"
						size = { 170 20 }
						elide = right
						using = fontsize_medium
					}
					textbox = {
						parentanchor = left|vcenter
						block "episcopal_seat_liturgical_rite" {
							text = "kog_gui_liturgical_rite_value"
							using = look_at_me_text_animation
						}
						size = { 170 20 }
						elide = right
						using = fontsize_medium
					}
					divider_clean = {
						parentanchor = center
					}
					
					# Opinion
					textbox = {
						parentanchor = left|vcenter
						text = "kog_gui_opinion_header"
						size = { 170 20 }
						elide = right
						using = fontsize_medium
					}
					textbox = {
						parentanchor = left|vcenter
						block "episcopal_seat_opinion" {
							text = "kog_gui_opinion_value"
							using = look_at_me_text_animation
						}
						size = { 170 20 }
						elide = right
						using = fontsize_medium
					}
				}
			}
			
			kog_seat_scripted_button_container = {
				blockoverride "kog_scripted_button_visibility" {}
			}
		}
	}
	
	type kog_seat_scripted_button_container = widget {
		parentanchor = top|hcenter
		size = { 190 180 }
		
		background = {
			using = entry_bg
		}
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			ignoreinvisible = yes
			spacing = 5
			margin_top = 5
			
			block "episcopal_seat_buttons_datamodel" {
				visible = "no"
			}
			
			item = {
				flowcontainer = {
					datamodel = "[JournalEntry.GetScriptedButtons]"
					direction = vertical
					ignoreinvisible = yes
					
					item = {
						widget = {
							visible = "[EqualTo_string(ScriptedButton.GetName, Scope.GetFlagName)]"
							size = { 154 38 }
							
							kog_seat_scripted_button_item = {
								parentanchor = center
							}
						}
					}
				}
			}
		}
	}
	
	type kog_seat_scripted_button_item = button {
		parentanchor = center
		size = { 174 38 }
		using = default_button_action
		
		enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
		onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
		tooltip = "SCRIPTED_ACTION_TOOLTIP"
		
		widget = {
			visible = "[ScriptedButton.IsSelected]"
			size = { 100% 100% }
			
			background = {
				using = paper_bg
			}
		}
		
		textbox = {
			parentanchor = center
			align = nobaseline
			autoresize = yes
			max_width = 165
			elide = right
			using = fontsize_small
			text = "[ScriptedButton.GetName]"
		}
		
		icon = {
			visible = "[ScriptedButton.IsSelected]"
			using = highlighted_square_selection
		}
	}
}