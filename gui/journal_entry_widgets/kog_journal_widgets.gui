				texture = "gfx/interface/icons/holy_site_icons/unused/kog_holy_site_vienna.dds"
			}
			blockoverride "holy_site_control_visibility" { }
			blockoverride "holy_site_not_controlled_visibility" {
				visible = "no"
			}
			blockoverride "holy_site_name" {
				text = "kog_vienna_header"
			}
