			}
			blockoverride "holy_site_name" {
				text = "kog_santiago_header"
			}
			blockoverride "holy_site_tooltip" { }
		}
		
		# Paris
		kog_holy_site_item = {
			blockoverride "holy_site_texture" {
				texture = "gfx/interface/icons/holy_site_icons/unused/kog_holy_site_paris.dds"
			}
			blockoverride "holy_site_control_visibility" { }
			blockoverride "holy_site_not_controlled_visibility" {
				visible = "no"
			}
			blockoverride "holy_site_name" {
				text = "kog_paris_header"
			}
			blockoverride "holy_site_tooltip" { }
		}
		
		# Koln
		kog_holy_site_item = {
			blockoverride "holy_site_texture" {
				texture = "gfx/interface/icons/holy_site_icons/unused/kog_holy_site_koln.dds"
			}
			blockoverride "holy_site_control_visibility" { }
			blockoverride "holy_site_not_controlled_visibility" {
				visible = "no"
			}
			blockoverride "holy_site_name" {
				text = "kog_koln_header"
			}
			blockoverride "holy_site_tooltip" { }
		}
		
		# Vienna
		kog_holy_site_item = {
			blockoverride "holy_site_texture" {
				texture = "gfx/interface/icons/holy_site_icons/unused/kog_holy_site_vienna.dds"
			}
			blockoverride "holy_site_control_visibility" { }
			blockoverride "holy_site_not_controlled_visibility" {
				visible = "no"
			}
			blockoverride "holy_site_name" {
				text = "kog_vienna_header"
			}
			blockoverride "holy_site_tooltip" { }
		}
	}
	
	type kog_holy_site_item = widget {
		size = { 520 120 }
		parentanchor = top|hcenter
		
