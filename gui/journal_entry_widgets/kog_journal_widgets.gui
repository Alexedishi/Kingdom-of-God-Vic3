# INHERITED FROM BASE GAME
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520
@panel_width_minus_10 = 530 # used to be 450
@panel_width = 540 # used to be 460
@panel_width_half = 270 # used to be 230
@panel_width_plus_10 = 550 # used to be 470
@panel_width_plus_14 = 554 # used to be 474
@panel_width_plus_14_half = 277 # used to be 237
@panel_width_plus_20 = 560 # used to be 480
@panel_width_plus_30 = 570 # used to be 490
@panel_width_plus_70 = 610 # used to be 530

####---------- KOG GLOBAL JOURNAL ENTRY WIDGETS ----------####
flowcontainer = {
	name = "widget_kog_catholic_church"
	ignoreinvisible = yes
	
	flowcontainer = {
		direction = vertical
		spacing = 10
		
		com_international_organization_header = {
			blockoverride "spacer_size" {
				size = { 540 50 }
			}
		}
		com_international_organization_panel = {
			blockoverride "interorg_journal_icon" {
				kog_journal_icon = {}
			}
			blockoverride "interorg_backdrop_texture" {
				texture = "gfx/interface/character_panel/backgrounds/kog_char_role_holy_see.dds"
			}
		}
		kog_denominational_tabs = {}
		com_international_organization_buttons = { }
		com_international_organization_modifiers = { }
		com_international_organization_members = { }
	}
}


####---------- KOG JOURNAL ENTRY TYPES ----------####
types kog_journal_widget_types {
	
	type kog_journal_icon = widget {
		parentanchor = top|hcenter
		size = { 150 150 }
		position = { 0 -50 }
		icon = {
			parentanchor = center
			size = { 150 150 }
			position = { 2 2 }
			texture = "gfx/interface/backgrounds/com_bg_pb_frame.dds"
		}
		icon = {
			parentanchor = center
			size = { 150 150 }
			position = { 0 -20 }
			texture = "gfx/coat_of_arms/textured_emblems/kog_frame_leaves_christian.dds"
		}
		icon = {
			parentanchor = center
			texture = "[JournalEntry.GetIcon]"
			position = { 0 -3 }
			size = { 75 75 }
		}
	}
	
	type kog_denominational_tabs = flowcontainer {
		parentanchor = top|hcenter
		direction = horizontal
		minimumsize = { 540 30 }
		
		background = {
			using = entry_bg
			margin = { 0 -2 }
		}
	}
}