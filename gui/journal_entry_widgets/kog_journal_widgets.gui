							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = alphamultiply
							alpha = 0.5
						}
					}
					textbox = {
						parentanchor = top|hcenter
						block "papabile_title_text" {
							raw_text = "#bold [Character.GetPrimaryRole.GetName]"
						}
						autoresize = yes
						elide = right
						using = fontsize_medium
						max_width = 160
						
					}
					textbox = {
						parentanchor = top|hcenter
						raw_text = "[Character.GetLastName]"
						autoresize = yes
						elide = right
						using = fontsize_medium
						max_width = 160
						
					}
				}
				
				textbox = {
					parentanchor = top|hcenter
					text = "kog_cardinal_gravitas"
					autoresize = yes
					elide = right
					using = fontsize_medium
					multiline = yes
					max_width = 160
					
					background = {
						using = dark_area
						alpha = 0.8
						margin = { 20 5 }
						
						modify_texture = {
							texture = "gfx/interface/masks/fade_horizontal_center.dds"
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = alphamultiply
						}
						modify_texture = {
							texture = "gfx/interface/masks/fade_vertical_center.dds"
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = alphamultiply
							alpha = 0.5
						}
					}
					
					background = {
						using = entry_bg
						margin = { 10 8 }
					}
					
					tooltip = "kog_cardinal_gravitas_breakdown"
				}
			}
		}
		
		widget = {
			parentanchor = top|right
			size = { 40 40 }
			position = { -16 20 }
			
			block "papabile_datacontext" {
				datacontext = "[GetPlayer.GetRuler]"
			}
			
			icon = {
				texture = "gfx/interface/backgrounds/round_button_bg.dds"
				parentanchor = center
				size = { 110% 110% }
			}
			icon = {
				visible = "[GetScriptedGui('kog_revolutionary_intent_sgui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
				texture = "gfx/interface/icons/theological_debate_icons/kog_debate_stance_modernizer.dds"
				parentanchor = center
				size = { 75% 75% }
			}
			icon = {
				visible = "[GetScriptedGui('kog_reformer_intent_sgui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
				texture = "gfx/interface/icons/theological_debate_icons/kog_debate_stance_reformer.dds"
				parentanchor = center
				size = { 75% 75% }
			}
			icon = {
				visible = "[GetScriptedGui('kog_conservative_intent_sgui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
				texture = "gfx/interface/icons/theological_debate_icons/kog_debate_stance_conservative.dds"
				parentanchor = center
				size = { 75% 75% }
			}
			icon = {
				visible = "[GetScriptedGui('kog_reactionary_intent_sgui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
				texture = "gfx/interface/icons/theological_debate_icons/kog_debate_stance_fundamentalist.dds"
				parentanchor = center
				size = { 75% 75% }
			}
