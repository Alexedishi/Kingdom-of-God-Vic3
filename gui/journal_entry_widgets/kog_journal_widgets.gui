# INHERITED FROM BASE GAME
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520
@panel_width_minus_10 = 530 # used to be 450
@panel_width = 540 # used to be 460
@panel_width_half = 270 # used to be 230
@panel_width_plus_10 = 550 # used to be 470
@panel_width_plus_14 = 554 # used to be 474
@panel_width_plus_14_half = 277 # used to be 237
@panel_width_plus_20 = 560 # used to be 480
@panel_width_plus_30 = 570 # used to be 490
@panel_width_plus_70 = 610 # used to be 530

####---------- KOG GLOBAL JOURNAL ENTRY WIDGETS ----------####
flowcontainer = {
	name = "widget_kog_church_interorg"
	ignoreinvisible = yes
	
	flowcontainer = {
		direction = vertical
		spacing = 10
		
		com_international_organization_header = {
			blockoverride "spacer_size" {
				size = { 540 60 }
			}
		}
		kog_head_of_faith_panel = { }
		kog_tab_buttons = { }
		kog_denominational_overview_panel = { }
		kog_metropolis_panel = { }
		kog_canon_laws_panel = { }
		kog_collegium_panel = { }
		kog_episcopal_seats_panel = { }
	}
}

####---------- KOG JOURNAL ENTRY TYPES ----------####
types kog_interorg_widget_types {
	type kog_journal_icon = widget {
		parentanchor = top|hcenter
		size = { 150 150 }
		position = { 0 -50 }
		icon = {
			parentanchor = center
			size = { 150 150 }
			position = { 2 2 }
			texture = "gfx/interface/backgrounds/com_bg_pb_frame.dds"
		}
		icon = {
			parentanchor = center
			size = { 150 150 }
			position = { 0 -20 }
			texture = "gfx/coat_of_arms/textured_emblems/kog_frame_leaves_christian.dds"
		}
		icon = {
			parentanchor = center
			texture = "[JournalEntry.GetIcon]"
			position = { 0 -3 }
			size = { 75 75 }
		}
	}
	
	type kog_head_of_faith_panel = com_international_organization_panel {
		blockoverride "interorg_journal_icon" {
			kog_journal_icon = { }
		}
		blockoverride "interorg_leader_title" {
			text = "kog_gui_head_of_faith"
		}
		blockoverride "interorg_backdrop_texture" {
			texture = "gfx/interface/character_panel/backgrounds/kog_char_role_holy_see.dds"
		}
		blockoverride "interorg_detail_1_visibility" {
			visible = "[ComJournalVar('kog_mother_church_var').IsSet]"
		}
		blockoverride "interorg_detail_1_name" {
			text = "kog_gui_mother_church_header"
		}
		blockoverride "interorg_detail_1_content" {
			text = "kog_gui_top_church_name"
		}
		blockoverride "interorg_detail_1_texture" {
			texture = "gfx/interface/icons/generic_icons/kog_autocephalous_patriarchate.dds"
		}
		blockoverride "interorg_detail_2_visibility" {
			visible = "[ComJournalVar('kog_location_var').IsSet]"
		}
		blockoverride "interorg_detail_2_name" {
			text = "kog_gui_location_header"
		}
		blockoverride "interorg_detail_2_content" {
			text = "kog_gui_location_name"
		}
		blockoverride "interorg_detail_2_texture" {
			texture = "gfx/interface/icons/generic_icons/kog_holy_site.dds"
		}
		blockoverride "interorg_detail_3_name" {
			text = "kog_gui_membership_header"
		}
		vfx = {
			position = { 0 -2 }
			
			blockoverride "entity_instance" {
				entity_instance = vfx_entity_ui_powerbloc_rank_02_rulers
			}
		}
		state = {
			name = _show
			alpha = 1
			duration = 0.1
			using = Animation_Curve_Default
			start_sound = {
				soundeffect = "event:/SFX/kog/kog_bell"
			}
		}
	}
	
	type kog_tab_buttons = widget {
		parentanchor = top|hcenter
		size = { 540 40 }
		
		tab_buttons = {
			parentanchor = center
			# OVERVIEW TAB
			blockoverride "first_button" {
				text = "kog_gui_overview_header"
			}
			blockoverride "first_button_selected" {
				text = "kog_gui_overview_header"
			}
			blockoverride "first_button_visibility_checked" {
				visible = "[And(Not(GetVariableSystem.HasValue('kog_denominational_tab', 'overview')), GetVariableSystem.Exists('kog_denominational_tab'))]"
			}
			blockoverride "first_button_visibility" {
				visible = "[Or(GetVariableSystem.HasValue('kog_denominational_tab', 'overview'), Not(GetVariableSystem.Exists('kog_denominational_tab')))]"
			}
			blockoverride "first_button_click" {
				onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'overview')]"
			}
			
			# METROPOLIS TAB
			blockoverride "second_button" {
				text = "kog_gui_metropolis_header"
			}
			blockoverride "second_button_selected" {
				text = "kog_gui_metropolis_header"
			}
			blockoverride "second_button_visibility_checked" {
				visible = "[And(
					GetScriptedGui(Concatenate(JournalEntry.GetType.GetKey, '_involvement_sgui')).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End),
					Not(GetVariableSystem.HasValue('kog_denominational_tab', 'metropolis'))
				)]"
			}
			blockoverride "second_button_visibility" {
				visible = "[And(
					GetScriptedGui(Concatenate(JournalEntry.GetType.GetKey, '_involvement_sgui')).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End),
					GetVariableSystem.HasValue('kog_denominational_tab', 'metropolis')
				)]"
			}
			blockoverride "second_button_click" {
				onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'metropolis')]"
			}
			
			# CANON LAW TAB
			blockoverride "third_button" {
				text = "kog_gui_canon_law_header"
			}
			blockoverride "third_button_selected" {
				text = "kog_gui_canon_law_header"
			}
			blockoverride "third_button_visibility_checked" {
				visible = "[Not(GetVariableSystem.HasValue('kog_denominational_tab', 'laws'))]"
			}
			blockoverride "third_button_visibility" {
				visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'laws')]"
			}
			blockoverride "third_button_click" {
				onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'laws')]"
			}
			
			# COLLEGIUM TAB
			blockoverride "fourth_button" {
				text = "kog_gui_college_header"
			}
			blockoverride "fourth_button_selected" {
				text = "kog_gui_college_header"
			}
			blockoverride "fourth_button_visibility_checked" {
				visible = "[And(
					GetScriptedGui('kog_canon_law_papal_primacy_sgui').IsShown(GuiScope.SetRoot(JournalEntry.MakeScope).End),
					Not(GetVariableSystem.HasValue('kog_denominational_tab', 'curia'))
				)]"
			}
			blockoverride "fourth_button_visibility" {
				visible = "[And(
					GetScriptedGui('kog_canon_law_papal_primacy_sgui').IsShown(GuiScope.SetRoot(JournalEntry.MakeScope).End),
					GetVariableSystem.HasValue('kog_denominational_tab', 'curia')
				)]"
			}
			blockoverride "fourth_button_click" {
				onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'curia')]"
			}
			
			# EPISCOPAL SEATS TAB
			blockoverride "fifth_button" {
				text = "kog_gui_seats_header"
			}
			blockoverride "fifth_button_selected" {
				text = "kog_gui_seats_header"
			}
			blockoverride "fifth_button_visibility_checked" {
				visible = "[Not(GetVariableSystem.HasValue('kog_denominational_tab', 'seats'))]"
			}
			blockoverride "fifth_button_visibility" {
				visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'seats')]"
			}
			blockoverride "fifth_button_click" {
				onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'seats')]"
			}
		}
	}
	
	type kog_scripted_button_item = button {
		parentanchor = top|hcenter
		using = default_button_action
		tooltip = "SCRIPTED_ACTION_TOOLTIP"
		enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
		onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
		size = { 460 45 }
		
		widget = {
			visible = "[ScriptedButton.IsSelected]"
			size = { 100% 100% }
			
			background = {
				using = paper_bg
			}
		}
		
		textbox = {
			parentanchor = center
			align = nobaseline
			autoresize = yes
			max_width = 300
			elide = right
			fontsize = 18
			text = "[ScriptedButton.GetName]"
		}
		
		icon = {
			visible = "[ScriptedButton.IsSelected]"
			using = highlighted_square_selection
		}
	}
}

types kog_overview_panel_types {
	type kog_denominational_overview_panel = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		
		visible = "[Or(GetVariableSystem.HasValue('kog_denominational_tab', 'overview'), Not(GetVariableSystem.Exists('kog_denominational_tab')))]"
		
		kog_encyclicals_container = { }
		kog_denominational_actions_container = { }
		com_international_organization_modifiers = { }
		kog_membership_panel = { }
		# kog_holy_sites_panel = {} # TODO enable holy sites when ready
	}
	
	type kog_encyclicals_container = flowcontainer {
		direction = vertical
		parentanchor = top|hcenter
		ignoreinvisible = yes
		minimumsize = { 540 -1 }
		using = entry_bg_fancy
		spacing = 10
		margin_bottom = 20
		
		default_header_clean_faded = {
			parentanchor = hcenter
			blockoverride "text" {
				text = "kog_gui_encyclical_header"
			}
			blockoverride "size" {
				size = { 532 45 }
			}
		}
		
		textbox = {
			parentanchor = top|hcenter
			visible = "[Not(GetScriptedGui('kog_encyclicals_sgui').IsShown(GuiScope.SetRoot(JournalEntry.MakeScope ).End))]"
			autoresize = yes
			text = "kog_gui_encyclicals_disabled"
			align = center|nobaseline
			elide = right
			using = fontsize_large
		}
		
		textbox = {
			parentanchor = top|hcenter
			visible = "[And(
				GetScriptedGui('kog_encyclicals_sgui').IsShown(GuiScope.SetRoot(JournalEntry.MakeScope ).End),
				IsDataModelEmpty(JournalEntry.MakeScope.GetList('kog_encyclicals_list'))
			)]"
			autoresize = yes
			text = "kog_gui_no_encyclical"
			align = center|nobaseline
			elide = right
			using = fontsize_large
		}
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			visible = "[Not(
				IsDataModelEmpty(JournalEntry.MakeScope.GetList('kog_encyclicals_list'))
			)]"
			datamodel = "[JournalEntry.MakeScope.GetList('kog_encyclicals_list')]"
			spacing = 2
			item = {
				kog_encyclical_item = { }
			}
		}
	}
	
	type kog_encyclical_item = flowcontainer {
		direction = vertical
		minimumsize = { @panel_width_minus_30 -1 }
		margin_bottom = 10
		
		datacontext = "[Scope.GetJournalEntry]"
		visible = "[JournalEntry.IsValid]"
		
		background = {
			using = dark_area
			alpha = 0.25
			margin = { -5 -5 }
		}
		
		button = {
			minimumsize = { @panel_width_minus_30 40 }
			using = com_international_organization_entry_properties
			onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
			enabled = "[JournalEntry.IsActive]"
			
			background = {
				using = default_header_bg
				margin = { -5 0 }
			}
			
			widget = {
				size = { 100% 100% }
				using = entry_bg_fancy
			}
			
			tooltipwidget = {
				FancyTooltip_JournalEntry = { }
			}
			
			onmousehierarchyenter = "[PdxGuiWidget.FindChild('journal_pin_button').InterruptThenTriggerAnimation('hide_journal_pin_button','show_journal_pin_button')]"
			onmousehierarchyleave = "[PdxGuiWidget.FindChild('journal_pin_button').InterruptThenTriggerAnimation('show_journal_pin_button','hide_journal_pin_button')]"
			
			## UPPER ROW
			flowcontainer = {
				resizeparent = yes
				direction = horizontal
				minimumsize = { @panel_width_minus_30 -1 }
				spacing = 5
				
				widget = {
					size = { 50 40 }
					icon = {
						parentanchor = top|left
						position = { -7 -7 }
						size = { 60 60 }
						texture = "gfx/interface/backgrounds/round_button_bg.dds"
						
						icon = {
							parentanchor = center
							size = { 40 40 }
							texture = "[JournalEntry.GetIcon]"
						}
					}
				}
				
				widget = {
					size = { 23 23 }
					parentanchor = center
					visible = "[JournalEntry.IsActive]"
					
					button = {
						name = "journal_pin_button"
						texture = "gfx/interface/outliner/unpinned_icon.dds"
						using = check_button_sound
						size = { 100% 100% }
						visible = "[Not(JournalEntry.IsPinnedInOutliner)]"
						onclick = "[JournalEntry.TogglePinInOutliner]"
						tooltip = "PIN"
						parentanchor = center
					}
					button = {
						using = check_button_sound
						texture = "gfx/interface/outliner/pinned_icon.dds"
						size = { 100% 100% }
						visible = "[JournalEntry.IsPinnedInOutliner]"
						onclick = "[JournalEntry.TogglePinInOutliner]"
						tooltip = "UNPIN"
						parentanchor = center
					}
				}
				
				widget = {
					parentanchor = center
					size = { 390 30 }
					textbox = {
						position = { 0 1 }
						text = "[JournalEntry.GetName]"
						autoresize = yes
						align = left|nobaseline
						multiline = yes
						default_format = "#header"
						using = fontsize_large
					}
				}
			}
		}
		
		## MIDDLE ROW
		flowcontainer = {
			direction = vertical
			spacing = 5
			margin_top = 4
			margin_left = 40
			minimumsize = { @panel_width_minus_30 40 }
			
			flowcontainer = {
				visible = "[And(JournalEntry.CanTimeOut, JournalEntry.IsActive)]"
				spacing = 5
				
				icon = {
					size = { 18 18 }
					texture = "gfx/interface/icons/generic_icons/clock.dds"
					parentanchor = vcenter
				}
				textbox = {
					text = "[JournalEntry.GetTimeoutTooltip]"
					autoresize = yes
					align = left|nobaseline
					parentanchor = vcenter
				}
			}
			
			textbox = {
				text = "[JournalEntry.GetStatusDesc]"
				visible = "[Not(StringIsEmpty(JournalEntry.GetStatusDesc))]"
				autoresize = yes
				align = right|nobaseline
				multiline = yes
			}
		}
	}
	
	type kog_denominational_actions_container = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 540 -1 }
		spacing = 10
		margin_bottom = 15
		
		using = entry_bg_fancy
		
		default_header_clean_faded = {
			parentanchor = top|hcenter
			blockoverride "text" {
				text = "kog_gui_major_actions"
			}
			blockoverride "size" {
				size = { 532 45 }
			}
		}
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			spacing = 5
			
			datamodel = "[JournalEntry.GetScriptedButtons]"
			
			item = {
				kog_scripted_button_item = {
					visible = "[ScriptedButton.HasTag('major_decision')]"
				}
			}
		}
	}
	
	type kog_membership_panel = flowcontainer {
		direction = vertical
		parentanchor = top|hcenter
		minimumsize = { 540 -1 }
		using = entry_bg_fancy
		spacing = 10
		margin_bottom = 15
		
		default_header_clean_faded = {
			parentanchor = top|hcenter
			blockoverride "text" {
				text = "kog_community_header"
			}
			blockoverride "size" {
				size = { 532 45 }
			}
		}
		
		# MEMBERS IN COMMUNION CONTAINER
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			using = default_list_position
			min_width = @panel_width_minus_30
			max_width = @panel_width_minus_30
			margin = { 5 10 }
			spacing = 10
			
			background = {
				using = entry_bg_simple
			}
			
			visible = "[Not(IsDataModelEmpty(JournalEntry.MakeScope.GetList('kog_communion_list')))]"
			
			textbox = {
				parentanchor = top|hcenter
				autoresize = yes
				text = "kog_community_members_in_communion"
				align = center|nobaseline
				elide = right
				using = fontsize_large
			}
			
			divider_decorative = {
				parentanchor = top|hcenter
			}
			
			dynamicgridbox = {
				parentanchor = top|hcenter
				datamodel = "[JournalEntry.MakeScope.GetList('kog_communion_list')]"
				datamodel_wrap = 8
				flipdirection = yes
				ignoreinvisible = yes
				
				item = {
					widget = {
						datacontext = "[Scope.GetCountry]"
						size = { 60 40 }
						small_flag = { }
					}
				}
			}
		}
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			using = default_list_position
			min_width = @panel_width_minus_30
			max_width = @panel_width_minus_30
			margin = { 5 10 }
			spacing = 10
			
			background = {
				using = entry_bg_simple
			}
			
			textbox = {
				parentanchor = top|hcenter
				autoresize = yes
				text = "kog_community_members_in_schism"
				align = center|nobaseline
				elide = right
				using = fontsize_large
			}
			
			divider_decorative = {
				parentanchor = top|hcenter
			}
			
			textbox = {
				parentanchor = top|hcenter
				visible = "[IsDataModelEmpty(JournalEntry.MakeScope.GetList('kog_schism_list'))]"
				autoresize = yes
				text = "kog_community_church_undivided"
				align = center|nobaseline
				elide = right
				using = fontsize_large
			}
			
			dynamicgridbox = {
				parentanchor = top|hcenter
				visible = "[Not(IsDataModelEmpty(JournalEntry.MakeScope.GetList('kog_schism_list')))]"
				datamodel = "[JournalEntry.MakeScope.GetList('kog_schism_list')]"
				datamodel_wrap = 8
				flipdirection = yes
				
				item = {
					widget = {
						datacontext = "[Scope.GetCountry]"
						size = { 60 40 }
						small_flag = { }
					}
				}
			}
		}
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			using = default_list_position
			min_width = @panel_width_minus_30
			max_width = @panel_width_minus_30
			margin = { 5 10 }
			spacing = 10
			
			visible = "[Not(IsDataModelEmpty(JournalEntry.MakeScope.GetList('kog_autocephalous_list')))]"
			
			background = {
				using = entry_bg_simple
			}
			
			textbox = {
				parentanchor = top|hcenter
				autoresize = yes
				text = "kog_community_members_with_autocephaly"
				align = center|nobaseline
				elide = right
				using = fontsize_large
			}
			
			divider_decorative = {
				parentanchor = top|hcenter
			}
			
			dynamicgridbox = {
				parentanchor = top|hcenter
				
				datamodel = "[JournalEntry.MakeScope.GetList('kog_autocephalous_list')]"
				datamodel_wrap = 8
				flipdirection = yes
				
				item = {
					widget = {
						datacontext = "[Scope.GetCountry]"
						size = { 60 40 }
						small_flag = { }
					}
				}
			}
		}
	}
	
	type kog_holy_sites_panel = flowcontainer {
		direction = vertical
		parentanchor = top|hcenter
		minimumsize = { 540 -1 }
		using = entry_bg_fancy
		spacing = 10
		margin_bottom = 15
		
		default_header_clean_faded = {
			parentanchor = top|hcenter
			blockoverride "text" {
				text = "kog_gui_holy_sites_header"
			}
			blockoverride "size" {
				size = { 532 45 }
			}
		}
		
		# Rome
		kog_holy_site_item = {
			blockoverride "holy_site_background" {
				texture = "gfx/interface/illustrations/holy_sites/kog_saint_peters_basilica.dds"
			}
			blockoverride "holy_site_texture" {
				texture = "gfx/interface/icons/holy_site_icons/unused/kog_holy_site_rome.dds"
			}
