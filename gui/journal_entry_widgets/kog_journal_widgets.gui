	type kog_canon_laws_container = flowcontainer {
		parentanchor = top|hcenter
		spacing = 10
		direction = vertical
		
		# Apostolic Succession
		kog_canon_law_group_entry = {
			blockoverride "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/apostolic_succession.dds"
			}
			blockoverride "canon_law_group_name" {
				text = "kog_canon_lawgroup_apostolic_succession"
			}
			blockoverride "active_canon_law_flag" {
				text = "kog_gui_canon_law_apostolic_succession"
			}
			blockoverride "canon_law_debate_tag" {
				visible = "[ScriptedButton.HasTag('debate_apostolic_succession')]"
			}
			blockoverride "canon_law_button_tag" {
				visible = "[ScriptedButton.HasTag('canon_lawgroup_apostolic_succession')]"
			}
		}
		
		# Almsgiving
		kog_canon_law_group_entry = {
			blockoverride "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/almsgiving.dds"
			}
			blockoverride "canon_law_group_name" {
				text = "kog_canon_lawgroup_almsgiving"
			}
