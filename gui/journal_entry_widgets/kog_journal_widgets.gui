				kog_canon_law_icon = {}
				kog_canon_law_icon = {}
				kog_canon_law_icon = {}
				kog_canon_law_icon = {}
			}
		}
		
		# Clerical Marriage
		kog_canon_law_entry = {
			blockoverride "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/clerical_marriage.dds"
			}
			blockoverride "canon_law_group" {
				text = "kog_canon_lawgroup_clerical_marriage"
			}
			blockoverride "canon_law_flag" {
				text = "kog_gui_canon_law_clerical_marriage"
			}
			blockoverride "canon_law_button_content" {
				kog_canon_law_icon = {}
				kog_canon_law_icon = {}
			}
		}
		
		# Social Role
		kog_canon_law_entry = {
			blockoverride "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/social_role.dds"
			}
			blockoverride "canon_law_group" {
				text = "kog_canon_lawgroup_social_role"
			}
			blockoverride "canon_law_flag" {
				text = "kog_gui_canon_law_social_role"
			}
			blockoverride "canon_law_button_content" {
				kog_canon_law_icon = {}
				kog_canon_law_icon = {}
				kog_canon_law_icon = {}
				kog_canon_law_icon = {}
			}
		}
		
		# Stance on Sciences
		kog_canon_law_entry = {
			blockoverride "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/stance_on_sciences.dds"
			}
			blockoverride "canon_law_group" {
				text = "kog_canon_lawgroup_stance_on_sciences"
			}
			blockoverride "canon_law_flag" {
				text = "kog_gui_canon_law_sciences_stance"
			}
			blockoverride "canon_law_button_content" {
				kog_canon_law_icon = {}
				kog_canon_law_icon = {}
				kog_canon_law_icon = {}
				kog_canon_law_icon = {}
			}
		}
		
		# Crusades
		kog_canon_law_entry = {
			blockoverride "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/crusades.dds"
			}
			blockoverride "canon_law_group" {
				text = "kog_canon_lawgroup_crusades"
			}
			blockoverride "canon_law_flag" {
				text = "kog_gui_canon_law_crusades"
