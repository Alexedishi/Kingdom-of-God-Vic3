	type kog_canon_lawgroup_entry = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		
		minimumsize = { 520 120 }
		maximumsize = { 520 120 }
		spacing = 5
		margin_left = 10
		
		using = entry_bg_fancy
		
		background = {
			block "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/placeholder.dds"
			}
			size = { 100% 100% }
			fittype = centercrop
			spriteborder = { 0 20 }
			margin = { -5 -3 }
			
			modify_texture = {
				texture = "gfx/interface/illustrations/canon_laws/canon_law_image_mask.dds"
				spriteType = Corneredstretched
				blend_mode = alphamultiply
				texture_density = 2
			}
		}
		
		default_header_clean_faded = {
			position = { 0 0 }
			size = { 500 35 }
			blockoverride "text" {
			}
			textbox = {
				block "canon_law_group_name" {
					text = "kog_block_canon_law_group"
					using = look_at_me_text_animation
				}
				parentanchor = center
				position = { 0 0 }
				autoresize = yes
				max_width = 520
				elide = right
				using = fontsize_large
			}
		}
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = horizontal
			minimumsize = { 500 35 }
			maximumsize = { 500 35 }
			spacing = 5
			
			widget = {
				parentanchor = left|vcenter
				size = { 300 35 }
				
				textbox = {
					parentanchor = left|vcenter
					size = { 300 35 }
					position = { 5 0 }
					
					block "active_canon_law_flag" {
						text = "kog_block_canon_law_flag"
						using = look_at_me_text_animation
					}
					autoresize = yes
					max_width = 320
					elide = right
					using = fontsize_medium
				}
			}
			
			widget = {
				parentanchor = right|vcenter
				size = { 200 35 }
				
				flowcontainer = {
					parentanchor = center
					ignoreinvisible = yes
					block "canon_law_button_datamodel" {
						visible = "no"
					}
					
					item = {
						flowcontainer = {
							datamodel = "[JournalEntry.GetScriptedButtons]"
							direction = vertical
							
							item = {
								widget = {
									visible = "[EqualTo_string(ScriptedButton.GetName, Scope.GetFlagName)]"
									size = { 160 35 }
									
									kog_canon_law_debate_button = {
										parentanchor = center
									}
								}
							}
						}
					}
				}
			}
		}
		flowcontainer = {
			parentanchor = top|hcenter
			direction = horizontal
			minimumsize = { 500 35 }
			spacing = 10
			
			background = {
				using = dark_area
				margin = { 5 5 }
			}
			
			block "canon_law_button_content" {
				textbox = {
					text = "kog_block_canon_law_button_content"
					using = look_at_me_text_animation
					parentanchor = center
					autoresize = yes
					elide = right
					using = fontsize_medium
				}
			}
		}
	}
	
	type kog_canon_law_debate_button = button {
		parentanchor = center
		size = { 184 35 }
		position = { 0 -5 }
		
		using = default_button_action
		tooltip = "SCRIPTED_ACTION_TOOLTIP"
		enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
		onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
		
		widget = {
			visible = "[ScriptedButton.IsSelected]"
			size = { 100% 100% }
			
			background = {
				using = paper_bg
			}
		}
		
		textbox = {
			parentanchor = center
			align = nobaseline
			autoresize = yes
			max_width = 230
			elide = right
			using = fontsize_small
			text = "[ScriptedButton.GetName]"
		}
		
		icon = {
			visible = "[ScriptedButton.IsSelected]"
			using = highlighted_square_selection
		}
	}
	
	type kog_canon_law_type_entry = widget {
		parentanchor = center
		size = { 35 35 }
		
		icon = {
			block "canon_law_active_glow" {
				visible = "no"
			}
			using = rotate_glow_animation_02
			size = { 90 90 }
			alwaystransparent = yes
			parentanchor = center
			using = default_fade_in_out
		}
		icon = {
			parentanchor = center
			size = { 35 35 }
			texture = "gfx/interface/backgrounds/round_button_bg.dds"
			
			icon = {
				parentanchor = center
				block "kog_canon_law_icon_texture" {
					texture = "gfx/interface/error_frog.dds"
					using = look_at_me_text_animation
				}
				size = { 80% 80% }
			}
		}
		block "kog_canon_law_icon_tooltip" {}
	}
	
	type kog_collegium_panel = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		
		visible = "[And(
			DataModelHasItems(GetGlobalList('kog_cardinals_list')),
			GetVariableSystem.HasValue('kog_denominational_tab', 'curia')
		)]"
		datamodel = "[GetGlobalList('kog_cardinals_list')]"
		
		item = {
			kog_collegium_cardinal_widget = { }
		}
	}
	
	type kog_collegium_cardinal_widget = flowcontainer {
		minimumsize = { 520 120 }
		direction = horizontal
		spacing = 10
		
		datacontext = "[Scope.GetCharacter]"
		
		using = entry_bg_fancy
		
		widget = {
			size = { 120 120 }
			parentanchor = center
			
			character_portrait_medium = {
				parentanchor = center
				position = { 0 0 }
				blockoverride "show_hat" { }
				blockoverride "tooltip" { } #TODO Remove when Tooltip doesnt cause error anymore
				blockoverride "portrait_icons" { } #TODO Remove when Tooltip doesnt cause error anymore
				blockoverride "portrait_button" { } #TODO Remove when Tooltip doesnt cause error anymore
				blockoverride "ig_button" { }
				
				icon = {
					size = { 27 18 }
					position = { -10 0 }
					parentanchor = bottom|left
					
					texture = "[Scope.GetCharacter.GetCountry.GetFlag.GetSmallFlagTexture]"
					alwaystransparent = yes
					
					frame = "[Scope.GetCharacter.GetCountry.GetFlag.GetSmallFlagFrame]"
					framesize = "[GetSmallFlagFrameSize]"
					
					using = flag_overlay
					
					icon = {
						name = frame
						texture = "gfx/interface/flag/flag_power_tiny.dds"
						size = { 33 24 }
						framesize = { 66 48 }
						frame = "[Scope.GetCharacter.GetCountry.GetRankIconIndex]"
						alwaystransparent = yes
						parentanchor = center
						block "visibility" { }
					}
				}
				textbox = {
					text = "kog_cardinal_gravitas"
					position = { 14 0 }
					parentanchor = bottom|right
					autoresize = yes
					elide = right
					using = fontsize_medium
					
					background = {
						using = dark_area
						alpha = 0.5
						margin = { 2 2 }
					}
					
					tooltip = "kog_cardinal_gravitas_breakdown"
				}
				
				widget = {
					parentanchor = top|right
					position = { 5 -5 }
					size = { 35 35 }
					
					visible = "[EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0')]"
					
					icon = {
						using = rotate_glow_animation_02
						size = { 60 60 }
						parentanchor = center
						position = { 0 0 }
						
						icon = {
							texture = "gfx/interface/icons/generic_icons/kog_preferatus.dds"
							parentanchor = center
							size = { 35 35 }
							position = { 4 4 }
							
							
						}
					}
					
					tooltip = "kog_placeholder_text"
				}
			}
		}
		
		flowcontainer = {
			parentanchor = center
			direction = vertical
			minimumsize = { 220 100 }
			
			margin = { 10 0 }
			
			background = {
				using = dark_area
				alpha = 0.25
			}
			
			default_header_clean_faded = {
				size = { 220 30 }
				parentanchor = top|hcenter
				blockoverride "text" { }
				textbox = {
					text = "kog_gui_name"
					parentanchor = center
					position = { 0 0 }
					autoresize = yes
					max_width = 250
					elide = right
					using = fontsize_medium
				}
			}
			textbox = {
				text = "kog_gui_title"
				parentanchor = left|vcenter
				position = { 0 0 }
				autoresize = yes
				max_width = 250
				elide = right
				using = fontsize_medium
			}
			textbox = {
				text = "kog_cardinal_gravitas"
				parentanchor = left|vcenter
				position = { 0 0 }
				autoresize = yes
				max_width = 250
				elide = right
				using = fontsize_medium
			}
			textbox = {
				text = "kog_gui_homeland"
				parentanchor = left|vcenter
				position = { 0 0 }
				autoresize = yes
				max_width = 250
				elide = right
				using = fontsize_medium
			}
		}
		
		dynamicgridbox = {
			parentanchor = center
			layoutpolicy_vertical = preferred
			datamodel = "[Character.AccessTraits]"
			datamodel_wrap = 3
			flipdirection = yes
			
			background = {
				using = dark_area
				alpha = 0.25
			}
			
			item = {
				flowcontainer = {
					margin = { 5 5 }
					alpha = "[TransparentIfTrue(CharacterTrait.IsDisabled)]"
					
					tooltipwidget = {
						FancyTooltip_CharacterTrait = { }
					}
					icon = {
						size = { 32 45 }
						texture = "[CharacterTrait.GetTexture]"
					}
				}
			}
		}
	}
	
