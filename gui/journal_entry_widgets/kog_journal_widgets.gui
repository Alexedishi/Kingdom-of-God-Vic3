# INHERITED FROM BASE GAME
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520
@panel_width_minus_10 = 530 # used to be 450
@panel_width = 540 # used to be 460
@panel_width_half = 270 # used to be 230
@panel_width_plus_10 = 550 # used to be 470
@panel_width_plus_14 = 554 # used to be 474
@panel_width_plus_14_half = 277 # used to be 237
@panel_width_plus_20 = 560 # used to be 480
@panel_width_plus_30 = 570 # used to be 490
@panel_width_plus_70 = 610 # used to be 530

####---------- KOG GLOBAL JOURNAL ENTRY WIDGETS ----------####
flowcontainer = {
	name = "widget_kog_catholic_church"
	ignoreinvisible = yes
	
	flowcontainer = {
		direction = vertical
		spacing = 10
		
		com_international_organization_header = {
			blockoverride "spacer_size" {
				size = { 540 60 }
			}
		}
		com_international_organization_panel = {
			blockoverride "interorg_journal_icon" {
				kog_journal_icon = {}
			}
			blockoverride "interorg_backdrop_texture" {
				texture = "gfx/interface/character_panel/backgrounds/kog_char_role_holy_see.dds"
			}
			blockoverride "interorg_leader_title" {
				text = "kog_gui_head_of_faith"
			}
			blockoverride "interorg_detail_2_texture" {
				texture = "gfx/interface/icons/generic_icons/kog_holy_site.dds"
			}
		}
		kog_denominational_tabs = {}
		kog_denominational_overview_panel = {}
		kog_canon_laws_panel = {}
		kog_collegium_panel = {}
		kog_holy_sites_panel = {}
		kog_episcopal_seats_panel = {}
	}
}


####---------- KOG JOURNAL ENTRY TYPES ----------####
types kog_journal_widget_types {
	
	type kog_journal_icon = widget {
		parentanchor = top|hcenter
		size = { 150 150 }
		position = { 0 -50 }
		icon = {
			parentanchor = center
			size = { 150 150 }
			position = { 2 2 }
			texture = "gfx/interface/backgrounds/com_bg_pb_frame.dds"
		}
		icon = {
			parentanchor = center
			size = { 150 150 }
			position = { 0 -20 }
			texture = "gfx/coat_of_arms/textured_emblems/kog_frame_leaves_christian.dds"
		}
		icon = {
			parentanchor = center
			texture = "[JournalEntry.GetIcon]"
			position = { 0 -3 }
			size = { 75 75 }
		}
	}
	
	type kog_denominational_tabs = flowcontainer {
		parentanchor = top|hcenter
		direction = horizontal
		minimumsize = { 540 40 }
		
		### START DIVIDER
		icon = {
			texture = "gfx/interface/tabs/tab_divider.dds"
			layoutpolicy_horizontal = fixed
			layoutpolicy_vertical = expanding
			size = { 5 -1 }
			spriteType = Corneredstretched
			spriteborder = { 0 20 }
		}
		
		# OVERVIEW TAB
		tab_button = {
			minimumsize = { 108 -1 }
			visible = "[And(Not(GetVariableSystem.HasValue('kog_denominational_tab', 'overview')), GetVariableSystem.Exists('kog_denominational_tab'))]"
			textbox = {
				text = "kog_gui_overview_header"
				default_format = "#title"
				using = tab_text_properties
			}
			
			onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'overview')]"
			tooltip = "TAB_1"
			input_action = "tab_1"
			using = tooltip_above
			
		}
		icon = {
			minimumsize = { 108 -1 }
			using = selected_tabs
			visible = "[Or(GetVariableSystem.HasValue('kog_denominational_tab', 'overview'), Not(GetVariableSystem.Exists('kog_denominational_tab')))]"
			
			textbox = {
				text = "kog_gui_overview_header"
				default_format = "#variable"
				using = tab_text_properties
			}
		}
		
		# CANON LAWS TAB
		tab_button = {
			minimumsize = { 108 -1 }
			visible = "[Not(GetVariableSystem.HasValue('kog_denominational_tab', 'laws'))]"
			textbox = {
				text = "kog_gui_canon_law_header"
				default_format = "#title"
				using = tab_text_properties
			}
			
			onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'laws')]"
			tooltip = "TAB_2"
			input_action = "tab_2"
			using = tooltip_above
			
		}
		icon = {
			minimumsize = { 108 -1 }
			using = selected_tabs
			visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'laws')]"
			
			textbox = {
				text = "kog_gui_canon_law_header"
				default_format = "#variable"
				using = tab_text_properties
			}
		}
		
		# COLLEGIUM TAB
		tab_button = {
			minimumsize = { 108 -1 }
			visible = "[Not(GetVariableSystem.HasValue('kog_denominational_tab', 'curia'))]"
			textbox = {
				text = "kog_gui_college_header"
				default_format = "#title"
				using = tab_text_properties
			}
			
			onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'curia')]"
			tooltip = "TAB_3"
			input_action = "tab_3"
			using = tooltip_above
			
		}
		icon = {
			minimumsize = { 108 -1 }
			using = selected_tabs
			visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'curia')]"
			
			textbox = {
				text = "kog_gui_college_header"
				default_format = "#variable"
				using = tab_text_properties
			}
		}
		
		# HOLY SITES TAB
		tab_button = {
			minimumsize = { 108 -1 }
			visible = "[Not(GetVariableSystem.HasValue('kog_denominational_tab', 'sites'))]"
			textbox = {
				text = "kog_gui_holy_sites_header"
				default_format = "#title"
				using = tab_text_properties
			}
			
			onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'sites')]"
			tooltip = "TAB_3"
			input_action = "tab_3"
			using = tooltip_above
			
		}
		icon = {
			minimumsize = { 108 -1 }
			using = selected_tabs
			visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'sites')]"
			
			textbox = {
				text = "kog_gui_holy_sites_header"
				default_format = "#variable"
				using = tab_text_properties
			}
		}
		
		# HOLY SITES TAB
		tab_button = {
			minimumsize = { 108 -1 }
			visible = "[Not(GetVariableSystem.HasValue('kog_denominational_tab', 'seats'))]"
			textbox = {
				text = "kog_gui_seats_header"
				default_format = "#title"
				using = tab_text_properties
			}
			
			onclick = "[GetVariableSystem.Set('kog_denominational_tab', 'seats')]"
			tooltip = "TAB_3"
			input_action = "tab_3"
			using = tooltip_above
			
		}
		icon = {
			minimumsize = { 108 -1 }
			using = selected_tabs
			visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'seats')]"
			
			textbox = {
				text = "kog_gui_seats_header"
				default_format = "#variable"
				using = tab_text_properties
			}
		}
		
		### END DIVIDER
		icon = {
			texture = "gfx/interface/tabs/tab_divider.dds"
			layoutpolicy_horizontal = fixed
			layoutpolicy_vertical = expanding
			size = { 5 -1 }
			spriteType = Corneredstretched
			spriteborder = { 0 20 }
		}
	}
	
	type kog_denominational_overview_panel = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		
		visible = "[Or(GetVariableSystem.HasValue('kog_denominational_tab', 'overview'), Not(GetVariableSystem.Exists('kog_denominational_tab')))]"
		
		com_international_organization_buttons = { }
		com_international_organization_modifiers = { }
		com_international_organization_members = { }
	}
	
	type kog_canon_laws_panel = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		spacing = 10
		
		visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'laws')]"
		
		kog_canon_law_entry = {}
		kog_canon_law_entry = {}
		kog_canon_law_entry = {}
		kog_canon_law_entry = {}
		kog_canon_law_entry = {}
		kog_canon_law_entry = {}
		kog_canon_law_entry = {}
		kog_canon_law_entry = {}
		kog_canon_law_entry = {}
	}
	
	type kog_canon_law_entry = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		
		minimumsize = { 520 120 }
		maximumsize = { 520 120 }
		spacing = 10
		margin_left = 10
		
		using = entry_bg_fancy
		
		background = {
			block "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/canon_law_image_mask.dds"
			}
			size = { 100% 100% }
			spriteType = Corneredstretched
			spriteborder = { 0 20 }
			margin = { -5 -3 }
			
			modify_texture = {
				texture = "gfx/interface/illustrations/canon_laws/canon_law_image_mask.dds"
				spriteType = Corneredstretched
				blend_mode = alphamultiply
				texture_density = 2
			}
		}
		
		default_header_clean_faded = {
			position = { 0 0 }
			size = { 500 35 }
			blockoverride "text" {
			}
			textbox = {
				block "canon_law_group" {
					raw_text = "#TODO Override canon_law_group!"
					using = look_at_me_text_animation
				}
				parentanchor = center
				position = { 0 0 }
				autoresize = yes
				max_width = 520
				elide = right
				using = fontsize_large
			}
		}
		textbox = {
			block "canon_law_flag" {
				raw_text = "#TODO Override canon_law_flag!"
				using = look_at_me_text_animation
			}
			autoresize = yes
			max_width = 200
			elide = right
			using = fontsize_medium
		}
		flowcontainer = {
			direction = horizontal
			minimumsize = { 500 35 }
			spacing = 10
			
			background = {
				using = dark_area
				margin = { 5 5 }
			}
			
			block "canon_law_button_content" {
				textbox = {
					raw_text = "#TODO Override canon_law_button_content!"
					using = look_at_me_text_animation
					parentanchor = center
					position = { 0 0 }
					autoresize = yes
					elide = right
					using = fontsize_medium
				}
			}
		}
	}
	
	type kog_collegium_panel = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		
		visible = "[And(
			DataModelHasItems(GetGlobalList('kog_cardinals_list')),
			GetVariableSystem.HasValue('kog_denominational_tab', 'curia')
		)]"
		datamodel = "[GetGlobalList('kog_cardinals_list')]"
		
		item = {
			kog_collegium_cardinal_widget = {}
		}
	}
	
	type kog_collegium_cardinal_widget = flowcontainer {
		minimumsize = { 520 120 }
		direction = horizontal
		spacing = 10
		
		datacontext = "[Scope.GetCharacter]"
		
		using = entry_bg_fancy
		
		widget = {
			size = { 120 120 }
			parentanchor = center
			
			character_portrait_medium = {
				parentanchor = center
				position = { 0 0 }
				blockoverride "show_hat" {}
				blockoverride "tooltip" {} #TODO Remove when Tooltip doesnt cause error anymore
				blockoverride "portrait_icons" {} #TODO Remove when Tooltip doesnt cause error anymore
				blockoverride "portrait_button" {} #TODO Remove when Tooltip doesnt cause error anymore
				blockoverride "ig_button" {}
				
				icon = {
					size = { 27 18 }
					position = { -10 0 }
					parentanchor = bottom|left
					
					texture = "[Scope.GetCharacter.GetCountry.GetFlag.GetSmallFlagTexture]"
					alwaystransparent = yes
					
					frame = "[Scope.GetCharacter.GetCountry.GetFlag.GetSmallFlagFrame]"
					framesize = "[GetSmallFlagFrameSize]"
					
					using = flag_overlay
					
					icon = {
						name = frame
						texture = "gfx/interface/flag/flag_power_tiny.dds"
						size = { 33 24 }
						framesize = { 66 48 }
						frame = "[Scope.GetCharacter.GetCountry.GetRankIconIndex]"
						alwaystransparent = yes
						parentanchor = center
						block "visibility" {}
					}
				}
				textbox = {
					text = "kog_cardinal_gravitas"
					position = { 14 0 }
					parentanchor = bottom|right
					autoresize = yes
					elide = right
					using = fontsize_medium
					
					background = {
						using = dark_area
						alpha = 0.5
						margin = { 2 2 }
					}
					
					tooltip = "kog_cardinal_gravitas_breakdown"
				}
				
				widget = {
					parentanchor = top|right
					position = { 5 -5 }
					size = { 35 35 }
					
					visible = "[EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0')]"
					
					icon = {
						using = rotate_glow_animation_02
						size = { 60 60 }
						parentanchor = center
						position = { 0 0 }
						
						icon = {
							texture = "gfx/interface/icons/generic_icons/kog_preferatus.dds"
							parentanchor = center
							size = { 35 35 }
							position = { 4 4 }
							
							
						}
					}
					
					tooltip = "kog_placeholder_text"
				}
			}
		}
		
		flowcontainer = {
			parentanchor = center
			direction = vertical
			minimumsize = { 220 100 }
			
			margin = { 10 0 }
			
			background = {
				using = dark_area
				alpha = 0.25
			}
			
			default_header_clean_faded = {
				size = { 220 30 }
				parentanchor = top|hcenter
				blockoverride "text" {}
				textbox = {
					raw_text = "[Character.GetFullName]"
					parentanchor = center
					position = { 0 0 }
					autoresize = yes
					max_width = 250
					elide = right
					using = fontsize_medium
				}
			}
			textbox = {
				text = "kog_gui_title"
				parentanchor = left|vcenter
				position = { 0 0 }
				autoresize = yes
				max_width = 250
				elide = right
				using = fontsize_medium
			}
			textbox = {
				text = "kog_cardinal_gravitas"
				parentanchor = left|vcenter
				position = { 0 0 }
				autoresize = yes
				max_width = 250
				elide = right
				using = fontsize_medium
			}
			textbox = {
				text = "kog_gui_homeland"
				parentanchor = left|vcenter
				position = { 0 0 }
				autoresize = yes
				max_width = 250
				elide = right
				using = fontsize_medium
			}
		}
		
		dynamicgridbox = {
			parentanchor = center
			layoutpolicy_vertical = preferred
			datamodel = "[Character.AccessTraits]"
			datamodel_wrap = 3
			flipdirection = yes
			
			background = {
				using = dark_area
				alpha = 0.25
			}
			
			item = {
				flowcontainer = {
					margin = { 5 5 }
					alpha = "[TransparentIfTrue(CharacterTrait.IsDisabled)]"
					
					tooltipwidget = {
						FancyTooltip_CharacterTrait = { }
					}
					icon = {
						size = { 32 45 }
						texture = "[CharacterTrait.GetTexture]"
					}
				}
			}
		}
	}
	
	type kog_holy_sites_panel = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		
		visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'sites')]"
		
		kog_holy_site_item = {
			blockoverride "holy_site_background" {
				texture = "gfx/interface/illustrations/holy_sites/kog_saint_peters_basilica.dds"
			}
			blockoverride "holy_site_texture" {
				texture = "gfx/interface/icons/generic_icons/kog_holy_site_rome.dds"
			}
			blockoverride "holy_site_control_visibility" {}
			blockoverride "holy_site_not_controlled_visibility" {
				visible = "no"
			}
			blockoverride "holy_site_name" {
				text = "kog_rome_building"
			}
			blockoverride "holy_site_location" {
				raw_text = "Seated in [GetStateRegion('STATE_LAZIO').GetName]"
			}
			blockoverride "holy_site_controller" {
				raw_text = "Controller: Deez Nutz"
			}
			blockoverride "holy_site_tooltip" {}
		}
		kog_holy_site_item = {
			blockoverride "holy_site_texture" {
				texture = "gfx/interface/icons/generic_icons/kog_holy_site_santiago.dds"
			}
			blockoverride "holy_site_control_visibility" {}
			blockoverride "holy_site_not_controlled_visibility" {
				visible = "no"
			}
			blockoverride "holy_site_name" {
				text = "kog_santiago_building"
			}
			blockoverride "holy_site_tooltip" {}
		}
		kog_holy_site_item = {
			blockoverride "holy_site_texture" {
				texture = "gfx/interface/icons/generic_icons/kog_holy_site_paris.dds"
			}
			blockoverride "holy_site_control_visibility" {}
			blockoverride "holy_site_not_controlled_visibility" {
				visible = "no"
			}
			blockoverride "holy_site_name" {
				text = "kog_paris_building"
			}
			blockoverride "holy_site_tooltip" {}
		}
		kog_holy_site_item = {
			blockoverride "holy_site_texture" {
				texture = "gfx/interface/icons/generic_icons/kog_holy_site_koln.dds"
			}
			blockoverride "holy_site_control_visibility" {}
			blockoverride "holy_site_not_controlled_visibility" {
				visible = "no"
			}
			blockoverride "holy_site_name" {
				text = "kog_koln_building"
			}
			blockoverride "holy_site_tooltip" {}
		}
		kog_holy_site_item = {
			blockoverride "holy_site_texture" {
				texture = "gfx/interface/icons/generic_icons/kog_holy_site_vienna.dds"
			}
			blockoverride "holy_site_control_visibility" {}
			blockoverride "holy_site_not_controlled_visibility" {
				visible = "no"
			}
			blockoverride "holy_site_name" {
				text = "kog_vienna_building"
			}
			blockoverride "holy_site_tooltip" {}
		}
	}
	
	type kog_holy_site_item = widget {
		size = { 520 120 }
		parentanchor = center
		
		using = entry_bg_fancy
		
		background = {
			block "holy_site_background" {
				texture = "gfx/interface/illustrations/holy_sites/ck3_temple_generic_grass.dds"
			}
			fittype = centercrop
			using = frame_small_mask
			alpha = 0.75
		}
		icon = {
			using = dark_area
			parentanchor = top|hcenter
			size = { 100% 30% }
			alpha = 0.65
			position = { 0 3 }
			
			modify_texture = {
				texture = "gfx/interface/masks/fade_vertical_bottom.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = alphamultiply
			}
		}
		icon = {
			using = dark_area
			parentanchor = bottom|hcenter
			size = { 100% 30% }
			alpha = 0.65
			position = { 0 -4 }
			
			modify_texture = {
				texture = "gfx/interface/masks/fade_vertical_top.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = alphamultiply
			}
		}
		
		flowcontainer = {
			direction = horizontal
			minimumsize = { 520 120 }
			margin = { 10 0 }
			
			widget = {
				parentanchor = left|vcenter
				size = { 100 100 }
				icon = {
					block "holy_site_control_visibility" {}
					using = selected_sidepanel_animation
					size = { 90% 90% }
					alwaystransparent = yes
					parentanchor = center
					using = default_fade_in_out
				}
				icon = {
					size = { 100 100 }
					block "holy_site_texture" {
						texture = "gfx/interface/icons/generic_icons/kog_holy_site_generic.dds"
					}
					modify_texture = {
						block "holy_site_not_controlled_visibility" {
							visible = "no"
						}
						texture = "gfx/interface/backgrounds/grey.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = normal
						alpha = 0.5
					}
				}
				block "holy_site_tooltip" {}
			}
			
			widget = {
				size = { 400 120 }
				
				background = {
					using = dark_area
					margin = { 0 -10 }
				}
				
				flowcontainer = {
					direction = vertical
					margin_left = 10
					spacing = 5
					
					textbox = {
						block "holy_site_name" {
							raw_text = "#TODO Override holy_site_name!"
							using = look_at_me_text_animation
						}
						parentanchor = left|vcenter
						position = { 0 0 }
						autoresize = yes
						max_width = 250
						elide = right
						using = fontsize_large
					}
					textbox = {
						block "holy_site_location" {
							raw_text = "#TODO Override holy_site_location!"
							using = look_at_me_text_animation
						}
						parentanchor = left|vcenter
						position = { 0 0 }
						autoresize = yes
						max_width = 250
						elide = right
						using = fontsize_medium
					}
					textbox = {
						block "holy_site_controller" {
							raw_text = "#TODO Override holy_site_controller!"
							using = look_at_me_text_animation
						}
						parentanchor = left|vcenter
						position = { 0 0 }
						autoresize = yes
						max_width = 250
						elide = right
						using = fontsize_medium
					}
					textbox = {
						block "holy_site_perk" {
							raw_text = "#TODO Override holy_site_perk!"
							using = look_at_me_text_animation
						}
						parentanchor = left|vcenter
						position = { 0 0 }
						autoresize = yes
						max_width = 250
						elide = right
						using = fontsize_medium
					}
				}
			}
		}
	}
	
	type kog_episcopal_seats_panel = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		
		visible = "[GetVariableSystem.HasValue('kog_denominational_tab', 'seats')]"
		
		icon = {
			size = { 30 30 }
			texture = "gfx/interface/icons/generic_icons/clock.dds"
		}
