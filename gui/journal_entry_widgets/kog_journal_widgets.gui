			}
			blockoverride "canon_law_button_tag" {
				visible = "[ScriptedButton.HasTag('canon_lawgroup_almsgiving')]"
			}
		}
		
		# Stance Towards Icons
		kog_canon_law_group_entry = {
			blockoverride "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/iconography.dds"
			}
			blockoverride "canon_law_group_name" {
				text = "kog_canon_lawgroup_iconography"
			}
			blockoverride "active_canon_law_flag" {
				text = "kog_gui_canon_law_iconography"
			}
			blockoverride "canon_law_debate_tag" {
				visible = "[ScriptedButton.HasTag('debate_apostolic_succession')]"
			}
			blockoverride "canon_law_button_tag" {
				visible = "[ScriptedButton.HasTag('canon_lawgroup_iconography')]"
			}
		}
		
		# Church and State
		kog_canon_law_group_entry = {
			blockoverride "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/church_and_state.dds"
			}
			blockoverride "canon_law_group_name" {
				text = "kog_canon_lawgroup_statism"
			}
			blockoverride "active_canon_law_flag" {
				text = "kog_gui_canon_law_statism"
			}
			blockoverride "canon_law_debate_tag" {
				visible = "[ScriptedButton.HasTag('debate_statism')]"
			}
			blockoverride "canon_law_button_tag" {
				visible = "[ScriptedButton.HasTag('canon_lawgroup_statism')]"
			}
		}
		
		# Church and Nation
		kog_canon_law_group_entry = {
			blockoverride "canon_law_background" {
				texture = "gfx/interface/illustrations/canon_laws/church_and_nation.dds"
			}
