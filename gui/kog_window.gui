# = From Base Game
# Panel Constants
@panel_width_minus_10 = 530
@panel_width_minus_30 = 510
@panel_width = 540
@panel_width_half = 270
@panel_width_plus_10 = 550
@panel_width_plus_14 = 554
@panel_width_plus_14_half = 277
@panel_width_plus_20 = 560
@panel_width_plus_30 = 570
@panel_width_plus_70 = 610

widget = {
	name = "kog_main_window"
	size { 100% 100% }
	layer = layer_ingame_menu
	visible = "[GetMetaPlayer.GetPlayedOrObservedCountry.IsValid]"
	
	kog_alert_widget = {} # This opens the GUI if an alert variable is set
	kog_display_widget = {} # This opens the GUI if a local variable is set
	
	widget = {
		parentanchor = top|hcenter
		size = { 100% 100% }
		using = clickthrough_blocker
		visible = "[GetVariableSystem.HasValue('com_open_window', 'kog_sidebar_button_sgui')]"
		datacontext = "[GetPlayer]"
		
		# This initializes the GUI variable on a fresh load
		state = {
		  trigger_when = "[Not(GetVariableSystem.Exists('kog_tabs_var'))]"
		  on_finish = "[GetVariableSystem.Set('kog_tabs_var', 'kog_tab_catholic')]"
		}
		
		state = {
			name = _show
			alpha = 1
			duration = 0.1
			using = Animation_Curve_Default
			start_sound = {
				soundeffect = "event:/kog_bell_ring"
			}
			start_sound = {
				soundeffect = "snapshot:/Dynamic/mute_world_80"
			}
			start_sound = {
				soundeffect = "snapshot:/Dynamic/mute_vfx_war_100"
			}
			on_finish = "[GetVariableSystem.Set('com_fullscreen', 'com_fullscreen')]"
			# Close open panel before showing this one
			on_start = "[InformationPanelBar.ClosePanel]"
			on_start = "[MapListPanelManager.CloseCurrentPanel]"
		}
		
		state = {
			name = _hide
			alpha = 0
			duration = 0.2
			using = Animation_Curve_Default
			end_sound = {
				soundeffect = "event:/SFX/UI/SideBar/society_stop"
			}
			on_finish = "[GetVariableSystem.Clear('com_fullscreen')]"
		}
		
		background = {
			using = default_bg
			margin = { 40 40 }
		}
		
		## BACKGROUNDS
		kog_window_background = {}
		
		## HEADER
		kog_window_header = {}
		kog_header_left_fade = {}
		kog_header_right_fade = {}
		kog_header_top_filler = {}

		## WIDGET CONTENT
		kog_dev_window = {}
	}
	
}

types kog_kingdom_of_god_window_types {
	type kog_dev_window = vbox {
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		
		#visible = "[GetScriptedGui('kog_catholic_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
		spacing = 10
		margin_top = 180
		margin_bottom = 10
		margin_left = 60
		margin_right = 60
		
		using = default_fade_in_out
		
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 5
			
			### LEFT PANEL - LOCAL METROPOLIS
			vbox = {
				layoutstretchfactor_horizontal = 1
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10
				
				using = entry_bg_fancy
				
				default_header_clean = {
					blockoverride "header_mask" {
						using = frame_small_mask_top
					}
					blockoverride "size" {
						layoutpolicy_horizontal = expanding
						size = { 0 44 }
					}
					blockoverride "text" {
						text = "kog_gui_national_church_name"
					}
				}
				
				textbox = {
					autoresize = yes
					text = "kog_gui_communion_status"
					align = center|nobaseline
					elide = right
					using = fontsize_large
				}
				
				green_progressbar_horizontal = {
					size = { 400 30 }
					blockoverride "values" {
						min = 0
						max = 1000
						value = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('kog_papacy_capacity_value'))]"
					}
					textbox = {
						parentanchor = center
						autoresize = yes
						text = "kog_gui_catholic_capacity_amount"
						align = center|nobaseline
						elide = right
						using = fontsize_medium
					}
					tooltip = "kog_gui_catholic_capacity_breakdown"
				}
				
				# Devout Leader Panel
				hbox = {
					layoutpolicy_horizontal = expanding
					
					background = {
						texture = "gfx/interface/character_panel/backgrounds/char_role_politician.dds"
						spriteType = Corneredstretched
					}
					
					background = {
						texture = "gfx/interface/character_panel/char_bg_frame.dds"
						margin_left = 18
						margin_right = 10
						margin_bottom = 10
						spriteType = Corneredtiled
						
						spriteborder_left = 200
						spriteborder_right = 60
						spriteborder_top = 170
						spriteborder_bottom = 180
						
						texture_density = 2
					}
					
					### RULER
					character_with_background = {
						visible = "[Country.HasRuler]"
						datacontext = "[AccessPlayer.AccessRuler]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						minimumsize = { -1 340 }
						
						blockoverride "character_layout" {
							position = { 0 0 }
							size = { 70% 100% }
						}
						blockoverride "character_portrait_size" {
							size = { 110% 110% }
						}
						
						# ruler stats
						flowcontainer = {
							parentanchor = right|bottom
							position = { -5 -15 }
							margin = { 0 10 }
							margin_right = 10
							direction = vertical
							spacing = 5
							
							background = {
								using = dark_area
								alpha = 0.75
								
								modify_texture = {
									texture = "gfx/interface/masks/fade_horizontal_left_full.dds"
									blend_mode = alphamultiply
								}
							}
							
							### ROLE
							ruler_stats_entry = {
								tooltip = "CHARACTER_PRIMARY_ROLE_TOOLTIP"
								
								blockoverride "ruler_icon" {
									widget = {
										size = { 35 35 }
										icon = {
											size = { 100% 100% }
											texture = "gfx/interface/icons/character_role_icons/politician.dds"
										}
									}
								}
								blockoverride "label" {
									text = "[Concept('concept_ruler', Character.GetPrimaryRoleTitle)]"
								}
								blockoverride "text" {
									text = "[Character.GetFullName]"
								}
							}
							### INTEREST GROUP
							ruler_stats_entry = {
								datacontext = "[Character.AccessInterestGroup]"
								
								blockoverride "ruler_icon" {
									character_ig_button = {
										size = { 35 35 }
										blockoverride "in_government_icon" {}
									}
								}
								
								tooltipwidget = {
									FancyTooltip_IG = {}
								}
								
								blockoverride "label" {
									text = "INTEREST_GROUP"
								}
								blockoverride "text" {
									raw_text = "#v [Character.AccessInterestGroup.GetNameNoFormatting]#!"
								}
							}
							
							### IDEOLOGY
							ruler_stats_entry = {
								datacontext = "[Character.GetIdeology]"
								
								tooltipwidget = {
									FancyTooltip_Ideology = {}
								}
								blockoverride "icon_texture" {
									texture = "[Ideology.GetTexture]"
								}
								blockoverride "label" {
									text = "IDEOLOGY_CONCEPT"
								}
								blockoverride "text" {
									text = "CHARACTER_IDEOLOGY"
								}
							}
							#POPULARITY
							ruler_stats_entry = {
								tooltip = "POPULARITY_BREAKDOWN"
								
								blockoverride "icon_texture" {
									texture = "gfx/interface/icons/generic_icons/popularity.dds"
								}
								blockoverride "label" {
									text = "POPULARITY"
								}
								blockoverride "text" {
									text = "CHARACTER_POPULARITY"
								}
							}
							
							widget = { size = { 5 5 }}
							
							### TRAITS
							character_traits_no_label = {
								parentanchor = right
							}
						}
					}
				}
				
				# Metropolitan Action Buttons
				vbox = {
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding
					
					default_header_clean = {
						layoutpolicy_horizontal = expanding
						size = { 0 44 }
						blockoverride "text" {
							text = "kog_gui_metropolis_header"
						}
					}
					
					hbox = {
						layoutpolicy_vertical = shrinking
						layoutpolicy_horizontal = expanding
						spacing = 5
						
						vbox = {
							layoutpolicy_vertical = shrinking
							layoutpolicy_horizontal = expanding
							spacing = 10
							margin_top = 5
							margin_bottom = 15
							
							textbox = {
								autoresize = yes
								text = "kog_gui_national_piety"
								align = center|nobaseline
								elide = right
								using = fontsize_large
							}
							
							default_progressbar_horizontal = {
								size = { 250 24 }
								blockoverride "values" {
									min = 0
									max = 1000
									value = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('kog_papacy_capacity_value'))]"
								}
								textbox = {
									parentanchor = center
									autoresize = yes
									text = "kog_gui_national_piety_amount"
									align = center|nobaseline
									elide = right
									using = fontsize_medium
								}
								tooltip = "kog_gui_national_piety_breakdown"
							}
							
							button = { # Commission Icon Button
								size = { 240 44 }
								using = default_button_primary_big_action
								
								text = "kog_gui_venerate_apparition"
								using = fontsize_large
								
								#							datacontext = "[GetScriptedGui('kog_commission_icon_sgui')]"
								#							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								#							visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								#							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								tooltip = "kog_gui_venerate_apparation_desc"
							}
						}
					}
					
					expand = {}
				}
			}
			
			#### CENTER PANEL - DENOMINATIONAL COMMUNITY
			vbox = {
				layoutstretchfactor_horizontal = 2
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10
				
				background = {
					using = dark_area
				}
				
				using = entry_bg_fancy
				
				default_header_clean_faded = {
					parentanchor = top|hcenter
					layoutpolicy_horizontal = expanding
					size = { 0 44 }
					blockoverride "text" {
						text = "kog_gui_metropolis_header"
					}
				}
				
				#kog_metropolitan_tabs = { }
				
				# Metropolitan Panels
				#kog_catholic_metropolis_panel = { }
				
				# College of Cardinals Panel
				#kog_collegium_cardinalium_panel = { }
				
				# Global Community Panels
				#kog_catholic_global_panel = { }
				
				# Encyclical Panel
				#kog_catholic_encyclical_panel = { }
				
				# Ecumenical Council Panels
				#kog_catholic_council_panel = { }
				
				expand = {}
				
			}
			
			### RIGHT PANEL - GREATER CHRISTIAN COMMUNITY
			vbox = {
				layoutstretchfactor_horizontal = 1
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10
				
				using = entry_bg_fancy
				
				background = {
					using = entry_bg_simple
					margin = { -3 -3 }
				}
				
				background = {
					using = entry_bg_simple
					margin = { -3 -3 }
				}
				
				default_header_clean = {
					parentanchor = top|hcenter
					blockoverride "header_mask" {
						using = frame_small_mask_top
					}
					blockoverride "size" {
						layoutpolicy_horizontal = expanding
						size = { 0 44 }
					}
					blockoverride "text" {
						text = "kog_gui_christian_community"
					}
				}
				
				### SEAT GROUP BUTTONS
				#kog_seat_tab_buttons = { }
				#divider_clean = { }
				#kog_catholic_seats = { }
				#kog_orthodox_seats = { }
				#	kog_oriental_seats = {}
				#	kog_elysian_seats = {}
				
				expand = {}
			}
		}
	}
}